@model BrandsAllModel
@using Nop.Web.Models.Customization;

<div class="back-mobile" onclick="history.go(-1);return true;">Back</div>
<div class="mob-page-title">
    @if (Model.CurrentSymbol == "All")
    {
        <h1>All Brands</h1>
    }
    else
    {
        <h1>All Brands with "@Model.CurrentSymbol"</h1>
    }

</div>
<div class="page manufacturer-list-page">
    <div class="page-body">
        <div class="manufacturer-grid">
            @foreach (var item in Model.Manufacturers)
            {
                <div class="item-box">
                    <div class="manufacturer-item">
                        <div class="picture">
                            <a href="@Url.RouteUrl("Manufacturer", new { SeName = item.SeName })" title="@item.PictureModel.Title">
                                <img alt="@item.PictureModel.AlternateText" src="@item.PictureModel.ImageUrl" title="@item.PictureModel.Title" />
                            </a>
                        </div>
                         <h2 class="title">
                            <a href="@Url.RouteUrl("Manufacturer", new { SeName = item.SeName })" title="@item.PictureModel.Title">
                                @item.Name
                            </a>
                        </h2>
                        
                    </div>
                </div>
            }
        </div>
    </div>
</div>