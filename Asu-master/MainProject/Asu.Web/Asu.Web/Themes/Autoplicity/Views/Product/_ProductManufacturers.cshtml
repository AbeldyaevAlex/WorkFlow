@model IList<ManufacturerModel>
@using Nop.Web.Models.Catalog;
@if (Model.Count > 0)
{
    <div class="manufacturers">
        <span class="label">Manufacturer:</span>
        <span class="value">
            <a itemprop="brand" href="@Url.RouteUrl("Manufacturer", new { SeName = Model[0].SeName })">@Model[0].Name</a>
        </span>
    </div>
}