@using System.Web.Optimization
@using Nop.Core
@using Nop.Core.Domain
@using Nop.Core.Domain.Seo
@using Nop.Core.Infrastructure
@using Nop.Services.Localization
@using Nop.Core.Domain.Customers
@using Nop.Core.Domain.Returns
@model Nop.Web.Models.Catalog.ProductDetailsModel
@{
    bool supportResponsive = EngineContext.Current.Resolve<StoreInformationSettings>().ResponsiveDesignSupported;
}

@section header
{
    @(HttpContext.Current.IsDebuggingEnabled ? Styles.Render("~/styles/hproduct") : Html.InlineStyles("~/styles/hproduct"))
    @(HttpContext.Current.IsDebuggingEnabled ? Styles.Render("~/styles/fproduct") : Html.InlineStyles("~/styles/fproduct"))
}
@section footer
{
    @(HttpContext.Current.IsDebuggingEnabled ? Scripts.Render("~/scripts/product") : Scripts.RenderFormat("<script src=\"{0}\" async></script>", "~/scripts/product"))
}

@{
    Layout = "~/Views/Shared/_ColumnsTwo.cshtml";

    // title, meta
    Html.AddTitleParts(!string.IsNullOrEmpty(Model.MetaTitle) ? Model.MetaTitle : Model.Name);
    Html.AddMetaDescriptionParts(Model.MetaDescription);
    Html.AddMetaKeywordParts(Model.MetaKeywords);
    //Html.AppendCssFileParts("~/Themes/Autoplicity/Content/mobproductpage.css");
    var seoSettings = EngineContext.Current.Resolve<SeoSettings>();

    // canonical URL
    if (seoSettings.CanonicalUrlsEnabled)
    {
        string productUrl = Url.RouteUrl("Product", new { Model.SeName }, Request.Url.Scheme);
        Html.AddCanonicalUrlParts(productUrl);
    }

    // open graph META tags
    if (seoSettings.OpenGraphMetaTags)
    {
        string storeName = EngineContext.Current.Resolve<IStoreContext>().CurrentStore.GetLocalized(x => x.Name);
        Html.AddHeadCustomParts("<meta property=\"og:type\" content=\"product\" />");
        Html.AddHeadCustomParts("<meta property=\"og:title\" content=\"" + Html.Encode(Model.Name) + "\" />");
        Html.AddHeadCustomParts("<meta property=\"og:description\" content=\"" + Html.Encode(Model.MetaDescription) + "\" />");
        Html.AddHeadCustomParts("<meta property=\"og:image\" content=\"" + Model.DefaultPictureModel.ImageUrl + "\" />");
        Html.AddHeadCustomParts("<meta property=\"og:url\" content=\"" + Request.Url.AbsoluteUri + "\" />");
        Html.AddHeadCustomParts("<meta property=\"og:site_name\" content=\"" + Html.Encode(storeName) + "\" />");
    }

    // Twitter META tags
    if (seoSettings.TwitterMetaTags)
    {
        string storeName = EngineContext.Current.Resolve<IStoreContext>().CurrentStore.GetLocalized(x => x.Name);
        Html.AddHeadCustomParts("<meta property=\"twitter:card\" content=\"summary\" />");
        Html.AddHeadCustomParts("<meta property=\"twitter:site\" content=\"" + Html.Encode(storeName) + "\" />");
        Html.AddHeadCustomParts("<meta property=\"twitter:title\" content=\"" + Html.Encode(Model.Name) + "\" />");
        Html.AddHeadCustomParts("<meta property=\"twitter:description\" content=\"" + Html.Encode(Model.MetaDescription) + "\" />");
        Html.AddHeadCustomParts("<meta property=\"twitter:image\" content=\"" + Model.DefaultPictureModel.ImageUrl + "\" />");
        Html.AddHeadCustomParts("<meta property=\"twitter:url\" content=\"" + Request.Url.AbsoluteUri + "\" />");
    }

}
@section left {
    <input id="ptsProductId" type="hidden" value="@Model.Id" />
    @if (supportResponsive)
    {
        <div class="homepagelagebanner" id="homepagelagebanner">
            <div class="homepagebannertitle">
                Shop by Vehicle
            </div>
            <a href="" class="homepagebannertitle1" id="homepagebannertitle1">
                Shop by Vehicle <span class="icon"></span>
            </a>
            @Html.Partial("_VehicleFilter")
        </div>
        @Html.Partial("_IsAvailableToVehicle")
        <hr />
        <div class="bbb"></div>
        <hr />
    }
}
<!--product breadcrumb-->
@Html.Partial("_ProductBreadcrumb", Model.Breadcrumb)
@*@Html.Widget("productdetails_after_breadcrumb", Model.Id)*@
<div class="page product-details-page">
    <div class="page-body">
        @*@Html.Widget("productdetails_top", Model.Id)*@
        @using (Html.BeginRouteForm("Product", new { Model.SeName }, FormMethod.Post, new { id = "product-details-form" }))
        {
            <div itemscope itemtype="http://schema.org/Product" data-productid="@Model.Id">
                <div class="product-essential">
                    @*@Html.Widget("productdetails_before_pictures", Model.Id)*@
                    <!--product pictures-->
                    @Html.Partial("_ProductDetailsPictures", Model)
                    @*@Html.Widget("productdetails_after_pictures", Model.Id)*@
                    <div class="overview">
                        <div class="product-name">
                            <h1 itemprop="name">
                                @Model.Name
                            </h1>
                        </div>
                        <!--product manufacturer picture-->
                        @Html.Partial("_ProductManufacturerPictures", Model.ProductManufacturers)
                        <!--product reviews-->
                        @Html.Partial("_CustomProductReviewOverview", Model.ProductReviewOverview)
                        <hr class="mobhr" />
                        <div class="productpadeleft">
                            <!--product SKU, manufacturer part number, stock info-->
                            @Html.Partial("_SKU_Man_Stock", Model)
                            <!--product manufacturers-->
                            @Html.Partial("_ProductManufacturers", Model.ProductManufacturers)
                        </div>
                        <hr />
                        @if (!string.IsNullOrEmpty(Model.ShortDescription))
                        {
                            <div class="short-description">
                                @Html.Raw(Model.ShortDescription)
                            </div>
                        }<!-- 'Nobody beats our price' feature -->
                        <div class="CompetitorPriceleftblock">
                            @Html.Partial("_CompetitorPrice", Model.CompetitorPrices)
                            @Html.Partial("_VendorsInventory", Model.VendorQtyPrices)
                        </div>
                        <div class="rightinfoblock">
                            @*Free shipping*@
                            @if (Model.FreeShippingNotificationEnabled && Model.IsFreeShipping)
                            {
                                <div class="free-shipping">Free Shipping</div>
                            }
                            @*@Html.Widget("productdetails_overview_top", Model.Id)*@
                            <!--Back in stock subscription-->
                            @Html.Partial("_BackInStockSubscription", Model)
                            <!--sample download-->
                            @Html.Partial("_DownloadSample", Model)

                            <!--attributes-->
                            @{
                                var dataDictAttributes = new ViewDataDictionary();
                                dataDictAttributes.TemplateInfo.HtmlFieldPrefix = string.Format("attributes_{0}", Model.Id);
                                @Html.Partial("_ProductAttributes", Model.ProductVariantAttributes, dataDictAttributes)
                            }
                            <!--gift card-->
                            @{
                                var dataDictGiftCard = new ViewDataDictionary();
                                dataDictGiftCard.TemplateInfo.HtmlFieldPrefix = string.Format("giftcard_{0}", Model.Id);
                                @Html.Partial("_GiftCardInfo", Model.GiftCard, dataDictGiftCard)
                            }
                            <!--price & add to cart-->
                            @{
                                var dataDictPrice = new ViewDataDictionary();
                                dataDictPrice.TemplateInfo.HtmlFieldPrefix = string.Format("price_{0}", Model.Id);
                                @Html.Partial("_ProductPrice", Model.ProductPrice, dataDictPrice)
                                @Html.Partial("_StockQuantity", Model.AddToCart, new ViewDataDictionary { { "Manufacturers", Model.ProductManufacturers } })
                                if (!Model.ProductPrice.HidePrices)
                                {
                                    <div class="info">   @Html.Partial("_ProductCountDown")</div>
                                }
                                @Html.Action("ProductCashRebate", "Customization", new { productId = Model.Id })

                            }
                        </div>
                    </div>
                    @{
                        var dataDictAddToCart = new ViewDataDictionary();
                        dataDictAddToCart.TemplateInfo.HtmlFieldPrefix = string.Format("addtocart_{0}", Model.Id);
                        @Html.Partial("_AddToCart", Model.AddToCart, dataDictAddToCart)
                        @*@Html.Widget("productdetails_overview_bottom", Model.Id)*@
                    }
                </div>
                @Html.Partial("_ShareButton", Model)
                @Html.Partial("_ProductEmailAFriendButton", Model)
                @Html.Partial("_CompareProductsButton", Model)
                @*@Html.Partial("_AddToCartWishlistButton", Model.AddToCart, dataDictAddToCart)*@
                <div id="product-tabs" class="product-tabs">
                    <ul id="tab-headers" class="tab-headers">
                        <li><a href="#tab-1">Product Details</a></li>
                        <li><a href="#tab-2">Product reviews</a></li>
                        <li><a href="#tab-3">Fitment</a></li>
                        <li><a href="#tab-4">Return Policy</a></li>
                    </ul>
                    <div id="tab-1" class="product-details-tab">

                        <span class="description-product-name">
                            @Model.Name
                        </span>

                        <ul>
                            <li>
                                <span class="title">Product Details</span>
                                @Html.Partial("_ProductSpecifications", Model.ProductSpecifications)
                                @if (!string.IsNullOrEmpty(Model.FullDescription))
                                {
                                    <div class="full-description" itemprop="description">
                                        @Html.Raw(Model.FullDescription)
                                    </div>
                                }
                            </li>
                            <li>
                                <div id="mob-tab-button">
                                    <a id="mob-tab-button-a" href="">
                                        <span class="title">Product reviews  </span><span class="icon"></span>
                                    </a>
                                </div>
                                <div class="mob-reviews-tab"> @Html.Partial("_ProductReviewsOnPage", Model.ProductReviews)</div>
                            </li>
                        </ul>
                    </div>
                    <div id="tab-2" class="product-reviews-tab">
                        <a href="@Url.RouteUrl("ProductReviews", new { productId = Model.Id })" class="Reviewsbutton">@T("Reviews.Overview.AddNew")</a>
                        @Html.Partial("_ProductReviewsOnPage", Model.ProductReviews)
                    </div>
                    <div id="tab-3" class="product-fitments-tab">

                    </div>
                    <div id="tab-4" class="return-policy-tab">
                        <h1>Return Policy</h1>
                        Most products at Autoplicity.com are eligible for return within 30 days of the shipment date. Contact our Customer Service Department at 800-299-1028 to request approval for a return or email support@autoplicity.com All returns must be processed through the Customer Service Department. Upon approval, an RMA # will be issued with instructions on how and where to process your return. All items must be returned in new, un-used condition, contain original packaging and documentation and contain all hardware and accessories.
                    </div>

                    @*@Html.Widget("productdetails_before_collateral", Model.Id)*@
                    <div class="product-collateral">
                        <div id="productsAlsoPurchased"></div>

                        @*@Html.Partial("_ProductTierPrices", Model.TierPrices)
                            @Html.Partial("_ProductTags", Model.ProductTags)
                            @Html.Action("ProductsAlsoPurchased", "Product", new { productId = Model.Id })
                            @Html.Action("RelatedProducts", "Product", new { productId = Model.Id })*@
                    </div>
                </div>
            </div>
        }
        @*@Html.Widget("productdetails_bottom", Model.Id)*@
    </div>
</div>
@if (!WorkContext.CurrentCustomer.IsAdmin())
{
    @section customization
    {
        @Html.Partial("_GoogleAnalyticsVariables", Model)
    }
}