@model IList<CheckBoxListItem>
@if (Model != null && Model.Count > 0)
{
    var lastTopItem = Model.LastOrDefault(i => i.IsTop);
    foreach (var item in Model)
    {
        <li>
            <label>
                <label class="checkbox @(item.IsSelected ? "checked" : string.Empty)" onclick="checkBox.click(event, this)">
                    <input type="checkbox" class="checkbox" value="@item.Value" @(item.IsDisabled ? " disabled=\"disabled\"" : string.Empty) @(item.IsSelected ? " checked=\"checked\"" : string.Empty) style="visibility: hidden" />
                </label>
                <span>@item.Name</span>
            </label>
            <a style="display: none" href="@Url.RouteUrl(item.RouteName, new { item.SeName })">@item.Name</a>
        </li>
        if (lastTopItem != null && lastTopItem == item)
        {
            <li class='top-items-line'></li>
        }
    }
}
