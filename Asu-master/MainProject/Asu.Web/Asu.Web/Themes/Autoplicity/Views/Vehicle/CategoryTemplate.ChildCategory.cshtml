@using System.Web.Optimization
@using Nop.Core.Infrastructure
@using Nop.Core.Domain
@using Nop.Core.Domain.GoogleTagManager
@using Nop.Core.Domain.Seo
@using Nop.Web.Models.Catalog

@model CustomCategoryModel

@{
    var supportResponsive = EngineContext.Current.Resolve<StoreInformationSettings>().ResponsiveDesignSupported;
    var filterModel = Model.FilterModel;
    Html.AddTitleParts(string.Concat(filterModel.SearchTerms));
    var anyAsideFilterChecked = filterModel.SelectedCategoryIdsArray.Any() && !filterModel.SelectedCategoryIdsArray.Contains(filterModel.CId)
                                || filterModel.SelectedManufacturerIdsArray.Any() && !filterModel.SelectedManufacturerIdsArray.Contains(filterModel.MId)
                                || filterModel.SelectedPriceRangeIdsArray.Any() || filterModel.MinPrice.HasValue || filterModel.MaxPrice.HasValue
                                || filterModel.SelectedPerformanceAttributes.Any() || filterModel.SelectedTireLoadAttributes.Any() || filterModel.SelectedTireSpeedAttributes.Any()
                                || filterModel.SelectedTreadTypeAttributes.Any() || filterModel.SelectedSidewallAttributes.Any() || filterModel.SelectedLoadRangeAttributes.Any()
                                || filterModel.SelectedUtqgAttributes.Any() || filterModel.SelectedServiceDescriptionAttributes.Any() || filterModel.SelectedTireSizeAttributes.Any();
    var vehicleFilterSelected = filterModel.V != null && filterModel.V.Make > 0;
    var hasFilters = anyAsideFilterChecked || vehicleFilterSelected;
    var showUniversal = filterModel.V != null && filterModel.V.SU;

    var googleTagManagerService = EngineContext.Current.Resolve<Nop.Services.Customization.IGoogleTagManagerService>();
    var pageType = googleTagManagerService.PageType;
}

@{
    Layout = "~/Views/Shared/_ColumnsTwo.cshtml";
    var metaTitle = !String.IsNullOrEmpty(Model.MetaTitle) ? Model.MetaTitle : Model.Name;
    if (Model.IsVehicleSeoCategory)
    {
        Html.NopTitle(false, metaTitle);
    }
    else
    {
        Html.AddTitleParts(metaTitle);
    }

    Html.AddMetaDescriptionParts(String.IsNullOrEmpty(Model.MetaDescription) ? metaTitle : Model.MetaDescription);
    Html.AddMetaKeywordParts(Model.MetaKeywords);
    //Html.AppendCssFileParts("~/Themes/Autoplicity/Content/mobcategorypage.css");
    var canonicalUrlsEnabled = EngineContext.Current.Resolve<SeoSettings>().CanonicalUrlsEnabled;
    if (canonicalUrlsEnabled)
    {
        string categoryUrl;
        if (Model.IsVehicleSeoCategory && !string.IsNullOrEmpty(Model.VehicleSeName))
        {
            categoryUrl = Url.RouteUrl("VehicleSeo", new { SeName = Model.VehicleSeName }, this.Request.Url.Scheme);
        }
        else if (!string.IsNullOrEmpty(Model.CategoryManufacturerSeName))
        {
            categoryUrl = Url.RouteUrl("CategoryManufacturer", new { SeName = Model.CategoryManufacturerSeName }, this.Request.Url.Scheme);
        }
        else
        {
            categoryUrl = Url.RouteUrl("Category", new { SeName = Model.SeName }, this.Request.Url.Scheme);
        }

        if (Model.FilterModel.PFC.HasNextPage)
        {
            Html.AddHeadCustomParts($"<link rel=\"next\" href=\"{categoryUrl}?PFC.PageNumber={Model.FilterModel.PFC.PageNumber + 1}\">");
        }

        if (Model.FilterModel.PFC.HasPreviousPage)
        {
            if (Model.FilterModel.PFC.PageNumber == 2)
            {
                Html.AddHeadCustomParts($"<link rel=\"prev\" href=\"{categoryUrl}\">");
            }
            else
            {
                Html.AddHeadCustomParts($"<link rel=\"prev\" href=\"{categoryUrl}?PFC.PageNumber={Model.FilterModel.PFC.PageNumber - 1}\">");
            }
        }

        if (Model.FilterModel.PFC.PageNumber > 1)
        {
            categoryUrl += $"?PFC.PageNumber={Model.FilterModel.PFC.PageNumber}";
        }

        Html.AddCanonicalUrlParts(categoryUrl);
    }
}

@section header
{
    @(HttpContext.Current.IsDebuggingEnabled ? Styles.Render("~/styles/hproduct-search") : Html.InlineStyles("~/styles/hproduct-search"))
    @(HttpContext.Current.IsDebuggingEnabled ? Styles.Render("~/styles/bproduct-search") : Html.InlineStyles("~/styles/bproduct-search"))
    @(HttpContext.Current.IsDebuggingEnabled ? Styles.Render("~/styles/fproduct-search") : Html.InlineStyles("~/styles/fproduct-search"))
}
@section footer
{
    @(HttpContext.Current.IsDebuggingEnabled ? Scripts.Render("~/scripts/product-search") : Scripts.RenderFormat("<script src=\"{0}\"></script>", "~/scripts/product-search"))
}

@*<script type="text/javascript" src="/Themes/Autoplicity/Scripts/jquery.jscroll.min.js"></script>*@
@section left {
    @if (supportResponsive && pageType == PageType.Search || pageType == PageType.Category || pageType == PageType.Manufacturer)
    {
        <div id="vehicleFilterContainer">
            <input type="button" class="mobile-filter-open-btn" style="display: none;" value="Filters" />
            <div id="vehicleFilterBtn" class="filterName minus">
                Vehicle
            </div>
            @Html.Partial("_VehicleFilter", new ViewDataDictionary(this.ViewData) { { "RenderShowUniversalOption", vehicleFilterSelected }, { "ShowUniversal", showUniversal } })
        </div>
    }
    @Html.Partial("_SearchFilter", Model.FilterModel, new ViewDataDictionary(this.ViewData) { { "AnyAsideFilterChecked", anyAsideFilterChecked } })
}
@*category breadcrumb*@
@if (Model.DisplayBreadcrumb)
{
    @Html.Partial("_BreadCrumb", Model.Breadcrumb)
    @Html.Widget("categorydetails_after_breadcrumb", Model.Id)
}
@Html.Partial("_VehicleFilterPopup")
<div class="page category-page">
    <div class="search-container">
        <div class="search-results-box">
            <h1 class="h1-fat -searchresult">
                @Html.GetHeaderCategoryAlias(Model.Name)
                @*<button id="changeSizeBtn" type="button" class="search-filter-btn">Select size</button>*@
            </h1>
            @if (Model.BannerPictureModel.Any())
            {
                <div class="banner-picture brand-banner">
                    <img class="banner-picture" src="@Model.BannerPictureModel[0].BannerImageUrl" alt="@Model.Name" data-desktopbanner="@Model.BannerPictureModel[0].BannerImageUrl" data-mobilebanner="@Model.BannerPictureModel[0].MobileBannerImageUrl" />
                </div>
            }
            <div class="inputs">
                <span id="totalProducts">
                    @(filterModel.NoResults ? "0" : filterModel.TotalProducts.ToString("##,###"))
                </span>
                <span>&nbsp;results found</span>
            </div>
        </div>
    </div>
    @if (Model.FilterModel.PFC.AllowProductSorting && Model.FilterModel.Products.Count > 0)
    {
        <div class="product-sorting">
            <span class="sorttext1">@T("Catalog.OrderBy")</span>
            @Html.DropDownList("products-orderby", Model.FilterModel.PFC.AvailableSortOptions, new { @class = "f-orderby", onchange = "setSortOption(this.value);" })
            @{
                var itemsPerPage = 75;
                itemsPerPage = Model.FilterModel.TotalProducts > itemsPerPage ? itemsPerPage : Model.FilterModel.TotalProducts;
                var boundary = (Model.FilterModel.PFC.PageNumber - 1) * itemsPerPage;
                var totalProducts = Model.FilterModel.TotalProducts.ToString("##,###");
                var end = boundary + itemsPerPage;
            }
            <div class="page-content-box">
                <div class="page-content" @(!Model.FilterModel.NoResults ? "style=display: none;" : string.Empty)>
                    <span>Page</span>
                    <span id="pageNumber">@Model.FilterModel.PFC.PageNumber</span>
                </div>
                <div id="results-range-of-total" class="inputs">
                    @(boundary + 1) - @(end > Model.FilterModel.TotalProducts ? Model.FilterModel.TotalProducts : end) of @totalProducts results
                </div>
            </div>
        </div>
    }
    <div class="aside-filters-container">
        @Html.Partial("_AsideFilters", Model.FilterModel)
    </div>
    <div class="page-body">
        @Html.Widget("categorydetails_top", Model.Id)
        @*description*@
        @if (!String.IsNullOrWhiteSpace(Model.Description))
        {
            <div class="category-description">
                @Html.Raw(Model.Description)
            </div>
        }
        <div class="product-selectors">

        </div>
        @Html.Widget("categorydetails_before_filters", Model.Id)
        <div class="product-filters-wrapper">

        </div>
        @Html.Widget("categorydetails_before_product_list", Model.Id)
        @*product list*@
        <div class="search-results">
            @if (!String.IsNullOrEmpty(Model.FilterModel.Warning))
            {
                <strong class="warning">
                    @Model.FilterModel.Warning
                </strong>
            }

            <div id="no-results" @(!Model.FilterModel.NoResults ? "style=display:none;" : string.Empty)>
                <span id="filterNoResults" class="result">
                    @T("Search.NoResultsText")
                </span>
            </div>

            @*list mode*@<div id="productsList" class="product-list infinite-scroll">
                @Html.Partial("_FilterProductsList", filterModel.Products, new ViewDataDictionary(this.ViewData) { { "HasFilters", hasFilters } })
                @*@if (Model.FilterModel.PFC.TotalItems > Model.FilterModel.PFC.PageSize)
                    {
                        <span id="nextPageBlock" style="display:none;"></span>
                    }*@
            </div>
            <div id="pager" class="pager">
                @Html.Partial("_FilterPager", Model.FilterModel.PFC)
            </div>
        </div>
        @Html.Widget("categorydetails_bottom", Model.Id)
    </div>
</div>
<div class="main-content-overlay" style="display: none;"></div>

<div id="tire-configurator" style="display: none;">
    <div class="box-loader" style="display: none;">
        <div class="load_animate">
            <span></span>
        </div>
    </div>
    <h2 class="tire-configurator-popup-header">Select tire size</h2>
    <div id="tTireConfigurator" data="tireConfigurator">
        @using (Html.BeginForm("Tires", "Vehicle", FormMethod.Post, new { id = "tire-configurator-form" }))
        {
            @Html.Hidden("spec_type", "Tire")
            <div class="tire-dd-headers">
                <span class="tire-dd-header">Width</span>
                <span class="tire-dd-header">Ratio</span>
                <span class="tire-dd-header">Diameter</span>
            </div>

            @Html.DropDownList("section", Model.TireConfigurator.SectionValues, null, new { data_section = string.Empty })
            @Html.DropDownList("aspect", Model.TireConfigurator.AspectValues, "Select Ratio", new { data_aspect = string.Empty, disabled = "disabled" })
            @Html.DropDownList("rim", Model.TireConfigurator.RimValues, "Select Diameter", new { data_rim = string.Empty, disabled = "disabled" })
            <button type="button" id="tFindTireBtn" class="" value="Search">Find Tires</button>
        }
    </div>
</div>