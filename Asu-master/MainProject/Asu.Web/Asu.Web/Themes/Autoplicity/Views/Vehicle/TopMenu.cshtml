<ul>
    @foreach (var item in menu)
    {
        <li>
            <a class="@item.Class" href="@item.Link">
                <span></span>
                <p>@item.Name</p>
            </a>
            <ul class="header-menu-inner" @(item.SubMenu.Count != 0 ? string.Empty : "style=display:none")>
                @foreach (var subItem in item.SubMenu)
                {
                    <li><a href="@subItem.Link">@subItem.Name</a></li>
                }
            </ul>
        </li>
    }
</ul>