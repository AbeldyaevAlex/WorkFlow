@model Asu.Web.Models.Vehicles.FilterSearchModel

@using Asu.Core.Domain.Vehicles
@using Asu.Services.Seo

@if (Model.Products.Any())
{
    <div id="sortByBlock" class="sort-by search-filter-block" style="display: none;">
        <div class="filterName minus">Sort by</div>
        <ul id="sort-by" class="filterUl collapsed">
            <li>
                <div>
                    <input type="radio" name="sorter" value="0" @(Model.PFC.Sort == ProductSortingEnum.Position ? "checked" : string.Empty) />Most Popular
                </div>
            </li>
            <li>
                <input type="radio" name="sorter" value="10" @(Model.PFC.Sort == ProductSortingEnum.PriceAsc ? "checked" : string.Empty) />Lowest Price
            </li>
            <li>
                <input type="radio" name="sorter" value="11" @(Model.PFC.Sort == ProductSortingEnum.PriceDesc ? "checked" : string.Empty) />Highest Price
            </li>
        </ul>
    </div>
}

@if (Model.OriginalSubCategories.Any() && Model.SelectedCategoryIdsArray.Count == 1 && Model.SelectedCategoryIdsArray.First() == Model.CId)
{
    <div id="sub-categories-block" class="sub-categories search-filter-block">
        <div class="filterName minus">Section</div>
        <ul id="sub-category-list" class="filterUl">
            @foreach (var subCategory in Model.OriginalSubCategories)
            {
                <li>
                    <span style="cursor:pointer;" class="sub-category-filter-link">@subCategory.Name</span>
                    <a style="display:none;" href="@Url.RouteUrl("Category", new { SeName = SeoExtensions.GetSeName(subCategory.Id, "Category", 0) })">
                        @subCategory.Name
                    </a>
                </li>
            }
        </ul>
    </div>
}

@if (Model.FilterCategories.Any())
{
    <div class="filters--accordeon" @(Model.FilterCategories.Count == 1 ? "style=display:none;" : string.Empty)>
        <ul class="filters--accordeon-items">
            <li id="filterCategoriesBlock" class="filters--accordeon-item">
                @* TODO: add class 'active-item'*@
                <div class="filters--accordeon-title filterName">
                    <h6>Category</h6>
                    @if (Model.SelectedCategoryIdsArray.Count > 0 && Model.SelectedCategoryIdsArray.First() != Model.CId)
                    {
                        <span>@Model.SelectedCategoryIdsArray.Count</span>
                    }
                </div>
                <ul id="filterCategory" class="filterUl filters--accordeon-options">
                    @Html.Partial("_MobileCheckBoxListItems", Model.FilterCategories)
                </ul>
            </li>
        </ul>
    </div>
}

@if (Model.FilterManufacturers.Count > 0)
{
    <div class="filters--accordeon" @(Model.FilterManufacturers.Count == 1 ? "style=display:none;" : string.Empty)>
        <ul class="filters--accordeon-items">
            <li id="filterManufacturerBlock" class="filters--accordeon-item search-filter-block">
                <div class="filters--accordeon-title filterName">
                    <h6>Manufacturer</h6>
                    @if (Model.SelectedManufacturerIdsArray.Count > 0)
                    {
                        <span>@Model.SelectedManufacturerIdsArray.Count</span>
                    }
                </div>
                @if (Model.SelectedManufacturerIdsArray.Count > 10)
                {
                    <div class="brand-search-infilter-block">
                        <input id="brand-search-infilter" type="text" name="brand-search-infilter" value="" placeholder="Search..." />
                    </div>
                }
                <ul id="filterManufacturer" class="filterUl filters--accordeon-options">
                    @Html.Partial("_MobileCheckBoxListItems", Model.FilterManufacturers)
                </ul>
            </li>
        </ul>
    </div>
}

