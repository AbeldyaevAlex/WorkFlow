<ul class="mobile-menu-list">
    @foreach (var item in menu)
    {
        <li class="mobile-menu-list-item">
            <div class="mobile-menu-list-item-wrap">
                <a href="@item.Link" class="@item.Class limobmenu" id="firstLevelul">
                    <p>@item.Name</p>
                </a>
                <span class="mobile-menu-list-link-expand"></span>
            </div>

            <ul class="mobile-menu-list-inner">
                <li>
                    @foreach (var subItem in item.SubMenu)
                    {
                        <a href="@subItem.Link" title="Category @subItem.Name">@subItem.Name</a>
                    }
                </li>
            </ul>
        </li>
    }
</ul>