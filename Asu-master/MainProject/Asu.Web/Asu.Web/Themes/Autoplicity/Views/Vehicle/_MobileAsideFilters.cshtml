@model Nop.Web.Models.Vehicles.FilterSearchModel

@{
    var vehicleName = Model.V.FullName;
}

<div class="filters--labels">
    <ul class="filters--labels-list">
        @if (!string.IsNullOrEmpty(vehicleName))
    {
        <li class="aside-filter-item-vehicle">vehicle: @vehicleName</li>
    }

    @{
        var filters = Model.FilterCategories.Where(m => m.IsSelected).ToList();
    }

    @if (Model.CId != 214)
    {
        foreach (var filter in filters)
        {
            <li class="aside-filter-item-category aside-filter-unit" data-id="@filter.Value">category: <span>@filter.Name</span></li>
        }
    }

    @{
        filters = Model.FilterManufacturers.Where(m => m.IsSelected).ToList();
    }

    @foreach (var filter in filters)
    {
        <li class="aside-filter-item-manufacturer aside-filter-unit" data-id="@filter.Value">manufacturer: <span>@filter.Name</span></li>
    }

    @{
        filters = Model.PerformanceAttributes.Where(m => m.IsSelected).ToList();
    }

    @foreach (var filter in filters)
    {
        <li class="aside-filter-item-tire-performance aside-filter-unit" data-id="@filter.Value">tire performance: <span>@filter.Name</span></li>
    }

    @{
        filters = Model.TireRimSizeAttributes.Where(m => m.IsSelected).ToList();
    }

    @foreach (var filter in filters)
    {
        <li class="aside-filter-item-tire-rim-size aside-filter-unit" data-id="@filter.Value">rim size: <span>@filter.Name</span></li>
    }

    @{
        filters = Model.TireLoadAttributes.Where(m => m.IsSelected).ToList();
    }

    @foreach (var filter in filters)
    {
        <li class="aside-filter-item-tire-load aside-filter-unit" data-id="@filter.Value">tire load: <span>@filter.Name</span></li>
    }

    @{
        filters = Model.TireSpeedAttributes.Where(m => m.IsSelected).ToList();
    }

    @foreach (var filter in filters)
    {
        <li class="aside-filter-item-tire-speed aside-filter-unit" data-id="@filter.Value">tire speed: <span>@filter.Name</span></li>
    }

    @{
        filters = Model.TreadTypeAttributes.Where(m => m.IsSelected).ToList();
    }

    @foreach (var filter in filters)
    {
        <li class="aside-filter-item-tire-treadtype aside-filter-unit" data-id="@filter.Value">tread type: <span>@filter.Name</span></li>
    }

    @{
        filters = Model.SidewallAttributes.Where(m => m.IsSelected).ToList();
    }

    @foreach (var filter in filters)
    {
        <li class="aside-filter-item-tire-sidewall aside-filter-unit" data-id="@filter.Value">sidewall type: <span>@filter.Name</span></li>
    }

    @{
        filters = Model.LoadRangeAttributes.Where(m => m.IsSelected).ToList();
    }

    @foreach (var filter in filters)
    {
        <li class="aside-filter-item-tire-loadrange aside-filter-unit" data-id="@filter.Value">load range: <span>@filter.Name</span></li>
    }

    @{
        filters = Model.UtqgAttributes.Where(m => m.IsSelected).ToList();
    }

    @foreach (var filter in filters)
    {
        <li class="aside-filter-item-tire-utqg aside-filter-unit" data-id="@filter.Value">utqg: <span>@filter.Name</span></li>
    }

    @{
        filters = Model.ServiceDescriptionAttributes.Where(m => m.IsSelected).ToList();
    }

    @foreach (var filter in filters)
    {
        <li class="aside-filter-item-tire-service-description aside-filter-unit" data-id="@filter.Value">service desc: <span>@filter.Name</span></li>
    }

    @if (!string.IsNullOrEmpty(vehicleName))
    {
        filters = Model.TireSizeAttributes.Where(m => m.IsSelected).ToList();
        foreach (var filter in filters)
        {
            <li class="aside-filter-item-tire-size aside-filter-unit" data-id="@filter.Value">tire size: <span>@filter.Name</span></li>
        }
    }

    @if (Model.MinPrice.HasValue || Model.MaxPrice.HasValue)
    {
        var minPrice = Model.MinPrice;
        var maxPrice = Model.MaxPrice;
        <li class="aside-filter-item-price aside-filter-unit">price:@($"{(minPrice.HasValue ? $" from ${minPrice.Value}" : string.Empty)}{(maxPrice.HasValue ? $" to ${maxPrice.Value}" : string.Empty)}")</li>
    }
    </ul>
</div>

