@model IList<ProductSpecificationModel>

@using Nop.Web.Models.Catalog;

@if (Model.Count > 0)
{
    <div class="product-specs-box">
        <div class="title">
            <strong>@T("Products.Specs")</strong>
        </div>
        <table class="data-table">
            <colgroup>
                <col />
                <col />
            </colgroup>
            <tbody>
                @for (int i = 0; i < Model.Count; i++)
                {
                    var item = Model[i];
                    <tr @(i % 2 == 0 ? Html.Raw(" class=\"odd\"") : Html.Raw(" class=\"even\""))>
                        <td class="a-left spec-name">
                            @item.SpecificationAttributeName
                        </td>
                        <td class="a-left spec-value">
                            @Html.Raw(item.ValueRaw)

                            @if (item.SpecificationAttributeDescriptions.Any())
                            {
                                <div class="tooltip">
                                    <div class="help-img"></div>
                                    <span class="tooltiptext">
                                        @foreach (var description in item.SpecificationAttributeDescriptions)
                                        {
                                            @Html.Raw(description.SpecificationAttributeName) <text>:</text> @description.ValueRaw <br />
                                        }
                                    </span>
                                </div>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}