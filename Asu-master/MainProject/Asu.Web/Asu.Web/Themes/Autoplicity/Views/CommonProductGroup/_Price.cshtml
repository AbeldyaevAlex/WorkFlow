@using Nop.Core.Infrastructure;
@using Nop.Services.Catalog;

@model Nop.Web.Models.ProductGroups.ProductGroupPriceModel

@{ 
    var priceFormatter = EngineContext.Current.Resolve<IPriceFormatter>();
}

<div class="prices" itemprop="offers" itemscope itemtype="@(Model.MaxPrice.HasValue ? "https://schema.org/AggregateOffer" : "http://schema.org/Offer")">
    <div class="product-price">
        <span>@(!Model.MaxPrice.HasValue 
            ? $"from {priceFormatter.FormatPrice(Model.MinPrice)}" 
            : Model.MaxPrice.Value > Model.MinPrice 
                ? string.Format($"{priceFormatter.FormatPrice(Model.MinPrice)} - {priceFormatter.FormatPrice(Model.MaxPrice.Value)}") 
                : $"{priceFormatter.FormatPrice(Model.MaxPrice.Value)}")</span>
    </div>
    <link itemprop="availability" href="http://schema.org/InStock" style="display: none;" />
    <meta itemprop="itemCondition" content="NewCondition">
    <meta itemprop="seller" content="Autoplicity.com" />
    <meta itemprop="priceCurrency" content="USD">
    <meta itemprop="price" content="@Model.MinPrice" />
    @if (Model.MaxPrice.HasValue)
    {
        <meta itemprop="highPrice" content="@Model.MaxPrice" />
    }
</div>
