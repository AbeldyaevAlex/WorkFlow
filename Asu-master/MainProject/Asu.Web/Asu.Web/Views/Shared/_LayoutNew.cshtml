         new StyleSheet { ExtensionType = ExtensionType.Gantt },
         new StyleSheet { ExtensionType = ExtensionType.GridLookup },
         new StyleSheet { ExtensionType = ExtensionType.PivotGrid },
         new StyleSheet { ExtensionType = ExtensionType.BinaryImage },
         new StyleSheet { ExtensionType = ExtensionType.PopupControl },
         new StyleSheet { ExtensionType = ExtensionType.ReportDesigner },
         new StyleSheet { ExtensionType = ExtensionType.Image },
         new StyleSheet { ExtensionType = ExtensionType.ImageSlider },
         new StyleSheet { ExtensionType = ExtensionType.ProgressBar },
         new StyleSheet { ExtensionType = ExtensionType.Panel },
         new StyleSheet { ExtensionType = ExtensionType.VerticalGrid },
         new StyleSheet { ExtensionType = ExtensionType.Menu },
         new StyleSheet { ExtensionType = ExtensionType.FormLayout }
    )
    @Html.DevExpress().GetScripts(
        new Script { ExtensionSuite = ExtensionSuite.NavigationAndLayout },
        new Script { ExtensionSuite = ExtensionSuite.Editors },
        new Script { ExtensionSuite = ExtensionSuite.Report },
