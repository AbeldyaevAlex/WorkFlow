@model Asu.Web.ViewModel.MemoAddingMaterialCodeViewModel
<div class="k-d-flex k-justify-content-center">
    <div class="k-w-600">
        @(Html.Kendo().AutoComplete()
            .Name("PrkmOgt")
            .DataTextField("PrKm")
            .HtmlAttributes(new { style = "width:100%", placeholder = "",
                @class = "InputPrkmOgt",
                @id = "InputPrkmOgt"
                /*, required = "required", validationmessage = "Обязательное поле"*/
            })
            //.HtmlAttributes(new { style = "width:100%" })
            .Filter(FilterType.Contains)
            .DataSource(source =>
            {
                source.Read(read =>
                {
                    read.Action("ComboBoxMemoAddingPrkmRead", "Skm");
                });
            })

            )

    </div>
</div>
