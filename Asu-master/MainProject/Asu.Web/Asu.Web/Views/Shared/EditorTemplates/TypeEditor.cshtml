@model Asu.Web.ViewModel.MemoAddingMaterialCodeViewModel
@using Asu.Core;
@using Asu.Core.Infrastructure;
@using Kendo.Mvc.UI;
@using Kendo.Mvc.UI.Html;
@using Kendo.Mvc.UI.Fluent;
@using Kendo.Mvc.Extensions;
@(
    Html.Kendo().DropDownList()
        .Name("Status")
        .DataTextField("Status")
        .DataValueField("Id")
        .OptionLabel("Select Type...")
        .Enable(false)
        //.Filter(FilterType.Contains)
        .AutoBind(true)

    //.Events(p => p.Open("onOpenStatus"))
    .DataSource(source =>
    {

        source.Read(read =>
        {

            read.Action("AdaptiveMode_GetProducts", "Skm");

        });
        source.ServerFiltering(true);
    })
    .Filter(FilterType.Contains)

    )


