<div class="k-d-flex k-justify-content-center">
    <div class="k-w-600">
        @(Html.Kendo().AutoComplete()
            .Name("MarkaMater")
            .Enable(false)
            .DataTextField("MarkaMater")
            .HtmlAttributes(new { style = "width:100%", placeholder = "Введите марку материала",
                @class = "InputMarkaMater",
                @id = "InputMarkaMater"
                /*, required = "required", validationmessage = "Обязательное поле" */
            })
            //.HtmlAttributes(new { style = "width:100%" })
            .Filter(FilterType.Contains)
            .Events(p => p.Change("onChangeMarkaMaterial"))
            .DataSource(source =>
            {
                source.Read(read =>
                {
                    read.Action("ComboBoxMemoAddingMaterialMarkaRead", "Skm");
                }).ServerFiltering(true);
            })

            )

    </div>
</div>

