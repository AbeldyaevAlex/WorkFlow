@model Asu.Web.ViewModel.MemoAddingMaterialCodeViewModel
<div class="k-d-flex k-justify-content-center">
    <div class="k-w-600">
        @(Html.Kendo().AutoComplete()
            .Name("KratNaimEizm")
            .DataTextField("KratNaimEizm")
            .HtmlAttributes(new { style = "width:100%", placeholder = "Введите ед. измерения", required = "required", validationmessage = "Обязателен" })
            //.HtmlAttributes(new { style = "width:100%" })
            .Filter(FilterType.Contains)
            .DataSource(source =>
            {
                source.Read(read =>
                {
                    read.Action("ComboBoxMemoAddingMaterialEizmRead", "Skm");
                });
            })

            )

    </div>
</div>

