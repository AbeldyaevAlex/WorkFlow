<div class="k-d-flex k-justify-content-center">
    <div class="k-w-600">
        @(Html.Kendo().AutoCompleteFor(m => m.Km)
            .Name("Km")
            .DataTextField("Km")
            .HtmlAttributes(new { style = "width:100%",@name = "Km", @id = "InputKm", @class = "InputKm", required = "required", placeholder = "Введите КМ", validationmessage = "Обязателен" })
            .Filter(FilterType.Contains)
            .Suggest(true)
            .DataSource(source =>
            {
                source.Read(read =>
                {
                    read.Action("ComboBoxMemoAddingKmRead", "Skm").Data("onAdditionalData");
                }).ServerFiltering(true);
            })
            )
    </div>
</div>

