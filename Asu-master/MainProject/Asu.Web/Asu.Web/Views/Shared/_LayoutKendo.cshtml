    <div class="navbar navbar-inverse navbar-fixed-top nav-blue">
        <div class="container">
            <div class="navbar-header">
                <button type="button" class="navbar-toggle" data-toggle="collapse" data-target=".navbar-collapse">
                    <span class="icon-bar"></span>
                    <span class="icon-bar"></span>
                    <span class="icon-bar"></span>
                </button>
                @Html.ActionLink("Kendo Controls", "Index", "Registration", new { area = "" }, new { @class = "navbar-brand" })
