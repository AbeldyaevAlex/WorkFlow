@model Asu.Web.ViewModel.GostMaterGridViewModel
@using Asu.Core;
@using Asu.Core.Infrastructure;
@using Kendo.Mvc.UI;
@using Kendo.Mvc.Extensions;
@{
    Layout = "~/Views/Shared/_LayoutKendoForForm.cshtml";
    ViewBag.Title = "Служебные записки на добавление материала";
}

<h2 align="center">Служебные записки на добавление материала</h2>
<div class="row table-responsive" style="padding-left: 0%">
        <div class="col-12">
            @(Html.Kendo().Grid<Asu.Web.ViewModel.GostMaterGridViewModel>()
                        .Name("grid")
                        .Columns(columns =>
                        {

                            columns.Command(command => {command.Edit(); command.Destroy(); }).Width(210);
                            columns.Bound(p => p.Id).Title("").Width(600).ClientTemplate(@"<div class='product-photo'
                                   style='background-image: url(" + @Url.Content("~/Content/PkpImage/material.png") + ");'></div>").Width(50)
                                   .HeaderHtmlAttributes(new { style = "overflow: visible; white-space: normal; text-align: center; font-weight: bold; font-family: 'Arial'; font-size: 14px; background-color: #f5f5f5" });
                            columns.Bound(p => p.Gost).Title("ГОСТ").Width(600);
                            //columns.Bound(p => p.StatusDocument.Status).EditorTemplateName("TypeEditor").Width(600).Title("Статус");
                            columns.Bound(p => p.StatusDocument).Width(600).Title("Статус");
                            columns.Bound(p => p.PeriodOpenDate).Format("{0:MM/dd/yyyy}").Width(150);
                            //columns.Bound(p => p.StatusDocument).Width(150);
                        })
                        .ToolBar(tools =>
                        {
                            //tools.Custom().Name("newAdd").Text("+ Add Employee ").Url("#").HtmlAttributes(new { id = "newAdd" });
                            tools.Create();
                        })
                                        .Pageable(pageable => pageable.Refresh(true).Input(true).Numeric(true))
                                        .Sortable(sorting => sorting.Enabled(true))
                                        .Scrollable()
                                        .Filterable()
                                        .Selectable()
                                        .Groupable()
                        .Editable(editable => editable.Mode(GridEditMode.InLine).CreateAt(GridInsertRowPosition.Top))
                        .Resizable(resize => resize.Columns(true))
                        .HtmlAttributes(new { style = "height:900px;" })
                        .DataSource(dataSource => dataSource

                            .Ajax().Model(model =>
                            {
                                model.Id(p => p.Id);
                            })
                        .PageSize(500)
                        .Read(read => read.Action("MemoAddingMaterialCodeRead", "Skm"))
                        .Create(create => create.Action("AddMemoAddingMaterialCodeGridViewPartial", "Skm"))
                        .Update(update => update.Action("AddMemoAddingMaterialCodeGridViewPartial", "Skm"))
                        .Destroy(destroy => destroy.Action("AddMemoAddingMaterialCodeGridViewPartial", "Skm"))

                        )
                    )
        </div>
    </div>
