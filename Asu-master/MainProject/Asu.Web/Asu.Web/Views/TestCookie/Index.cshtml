@model WorkShopMemorandumBase
@using System.Web.UI.WebControls
@using DevExpress.Web.Mvc
@using Asu.Web.CustomAttribute;
@using DevExpress.Data.Filtering;
@using Asu.Web.Controllers;
@using Asu.Web.Models;
@using Asu.Web.Models.Customer;
@using Asu.Core;
@using Asu.Core.Infrastructure;
@using Kendo.Mvc.UI;
@{
    ViewBag.Title = "МСЗ";
    //Layout = "~/Views/Shared/_Layout.cshtml";
    Layout = "~/Views/Shared/_LayoutKendoForForm.cshtml";
}

@*<h2 align="center">МСЗ</h2>
    @Html.Action("MalahitMszGridViewPartial", "MainMalahit")*@

<div class="row">
    @using (Html.BeginForm("GetMSZ", "TestCookie", FormMethod.Post, new { @class = "form-horizontal" }))
    {
        <fieldset>

            <!-- Form Name -->
            <h2 align="center">Введите параметры для поиска МСЗ</h2>

            <!-- Text input-->
            <div class="form-group">
                @Html.LabelFor(model => model.zakaz, "Заказ", new { @class = "col-md-4 control-label" })
                <div class="col-md-4">
                    @*@Html.TextBoxFor(model => model.Name,
                        new
                           {
                               @class = "form-control",
                               placeholder = "Enter your name"
                               ,
                               required = "required"
                           })*@



                    @(
                        Html.Kendo().TextBoxFor(model => model.zakaz)
                              .Name("zakaz")
                              .HtmlAttributes(new { placeholder = "Введите заказ", required = "required", validationmessage = "Enter {0}",
                              @class="form-control"})
                      )
                    @Html.ValidationMessageFor(model => model.zakaz)
                </div>
            </div>

            <div class="form-group">
                @Html.LabelFor(model => model.start_date, "Начало периода", new { @class = "col-md-4 control-label" })
                <div class="col-md-4">

                    @*@Html.TextBoxFor(model => model.DOB, new { @class = "form-control datepicker", placeholder = "Enter DOB date" })
                        @Html.ValidationMessageFor(model => model.DOB)*@

                    @(
                        Html.Kendo().DatePickerFor(model => model.start_date)
                          .Name("start_date")
                          .Start(CalendarView.Year)
                          .Depth(CalendarView.Month)
                                                        .HtmlAttributes(new
                                                        {
                                                            placeholder = "Начало периода",
                                                        })
                    )
                    @Html.ValidationMessageFor(model => model.start_date)
                </div>
            </div>
            <div class="form-group">
                @Html.LabelFor(model => model.end_date, "Конец периода", new { @class = "col-md-4 control-label" })
                <div class="col-md-4">

                    @*@Html.TextBoxFor(model => model.DOB, new { @class = "form-control datepicker", placeholder = "Enter DOB date" })
                        @Html.ValidationMessageFor(model => model.DOB)*@

                    @(
                        Html.Kendo().DatePickerFor(model => model.end_date)
                          .Name("end_date")
                          .Start(CalendarView.Year)
                          .Depth(CalendarView.Month)
                          .HtmlAttributes(new
                          {
                              placeholder = "Конец периода",
                          })
                    )
                    @Html.ValidationMessageFor(model => model.end_date)
                </div>
            </div>
            <!-- Button -->
            <div class="form-group">
                <label class="col-md-4 control-label" for="signup"></label>
                <div class="col-md-4">
                    <input type="submit" value="Ok" class="btn btn-success" />
                </div>
            </div>

            <script type="text/javascript">
    $(function () { // will trigger when the document is ready
                    $('.datepicker').datepicker(); //Initialise any date pickers
                });</script>

        </fieldset>
    }


</div>