@model RegisterModel
@using Asu.Web.Models.Customer;
@{
    Layout = "~/Views/Shared/_ColumnsOne.cshtml";


    //title
    Html.AddTitleParts(T("PageTitle.Register").Text);
}

@if (Model.CountryEnabled && Model.StateProvinceEnabled)
{
    @* WC. Enable this when need (note that code should be moved to js file or it will not work)*@
    <script type="text/javascript">
            $(function () {
                $("#@Html.FieldIdFor(model => model.CountryId)").change(function () {
                 var selectedItem = $(this).val();
                 var ddlStates = $("#@Html.FieldIdFor(model => model.StateProvinceId)");
                    var statesProgress = $("#states-loading-progress");
                    statesProgress.show();
                    $.ajax({
                        cache: false,
                        type: "GET",
                        url: "@(Url.RouteUrl("GetStatesByCountryId"))",
                        data: { "countryId": selectedItem, "addEmptyStateIfRequired": "true" },
                        success: function (data) {
                            ddlStates.html('');
                            $.each(data, function (id, option) {
                                ddlStates.append($('<option></option>').val(option.id).html(option.name));
                            });
                            statesProgress.hide();
                        },
                        error: function (xhr, ajaxOptions, thrownError) {
                            alert('Failed to retrieve states.');
                            statesProgress.hide();
                        }
                    });
                });
         });
    </script>
}
@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    <div class="page registration-page">
        <div class="page-title">
            <h1>"@T("Account.Register")"</h1>
        </div>
        <div class="page-body">
            <div class="message-error">
                @Html.ValidationSummary(true)
            </div>
            @*@Html.Partial("_ExternalAuthentication.AssociateMessage")*@
            <div class="fieldset">
                <div class="title">
                    <strong>Account.YourPersonalDetails</strong>
                </div>
                <div class="inputs">
                    @if (Model.GenderEnabled)
                    {
                        <div class="inputs ">

                            <div class="gender">
                                @Html.RadioButton("Gender", "M", (Model.Gender == "M"), new { id = "gender-male" })
                                <label for="gender-male">"Account.Fields.Gender.Male"</label>
                            </div>
                            <div class="gender">
                                @Html.RadioButton("Gender", "F", (Model.Gender == "F"), new { id = "gender-female" })
                                <label for="gender-female">"Account.Fields.Gender.Female"</label>
                            </div>
                        </div>
                    }
                    <div class="inputs firstname">
                        @Html.TextBoxFor(model => model.FirstName, new { placeholder = "First name" })

                        @Html.ValidationMessageFor(model => model.FirstName)
                    </div>
                    <div class="inputs lastname">
                        @Html.TextBoxFor(model => model.LastName, new { placeholder = "Last name" })

                        @Html.ValidationMessageFor(model => model.LastName)
                    </div>
                    <div class="inputs lastname">
                        @Html.TextBoxFor(model => model.MiddleName, new { placeholder = "Middle name" })

                        @Html.ValidationMessageFor(model => model.MiddleName)
                    </div>
                    @if (Model.DateOfBirthEnabled)
                    {
                        <div class="inputs">

                            <div class="birthdate">
                                DateTime.Now.Year - 110,
                                DateTime.Now.Year,
                                Model.DateOfBirthDay,
                                Model.DateOfBirthMonth,
                                Model.DateOfBirthYear)
                                @Html.ValidationMessageFor(model => model.DateOfBirthDay)
                                @Html.ValidationMessageFor(model => model.DateOfBirthMonth)
                                @Html.ValidationMessageFor(model => model.DateOfBirthYear)
                            </div>


                        </div>
                    }
                    <div class="inputs">
                        @Html.TextBoxFor(model => model.Email, new { placeholder = "Email" })

                        @Html.ValidationMessageFor(model => model.Email)
                    </div>
                    @if (Model.UsernamesEnabled)
                    {
                        <div class="inputs">
                            @Html.TextBoxFor(model => model.Username, new { placeholder = "User name" })

                            @Html.ValidationMessageFor(model => model.Username)
                            @if (Model.CheckUsernameAvailabilityEnabled)
                            {
                                @Html.Partial("_CheckUsernameAvailability")
                            }
                        </div>

                    }
                </div>
            </div>
            @if (Model.CompanyEnabled || Model.DisplayVatNumber)
            {
                <div class="fieldset">
                    <div class="title">
                        <strong>"Account.CompanyDetails"</strong>
                    </div>

                    <div class="form-fields">
                        @if (Model.CompanyEnabled)
                        {
                            <div class="inputs">
                                @Html.TextBoxFor(model => model.Company, new { placeholder = "Company Name" })
                                @if (Model.CompanyRequired)
                                {

                                }
                                @Html.ValidationMessageFor(model => model.Company)
                            </div>
                        }
                        @if (Model.DisplayVatNumber)
                        {
                            <div class="inputs">
                                @Html.TextBoxFor(model => model.VatNumber, new { placeholder = "Vat Number" })
                                <span class="vat-note"><em>"Account.Fields.VatNumber.Note"</em></span>
                            </div>
                        }
                    </div>
                </div>
            }
            @if (Model.StreetAddressEnabled || Model.StreetAddress2Enabled || Model.ZipPostalCodeEnabled
            || Model.CityEnabled || Model.CountryEnabled)
            {
                <div class="fieldset">
                    <div class="title">
                        <strong>"Account.YourAddress"</strong>
                    </div>
                    <div class="form-fields">
                        @if (Model.StreetAddressEnabled)
                        {
                            <div class="inputs">
                                @Html.TextBoxFor(model => model.StreetAddress, new { placeholder = "Address 1" })
                                @if (Model.StreetAddressRequired)
                                {

                                }
                                @Html.ValidationMessageFor(model => model.StreetAddress)
                            </div>
                        }
                        @if (Model.StreetAddress2Enabled)
                        {
                            <div class="inputs">
                                @Html.TextBoxFor(model => model.StreetAddress2, new { placeholder = "Address 2" })
                                @if (Model.StreetAddress2Required)
                                {

                                }
                                @Html.ValidationMessageFor(model => model.StreetAddress2)
                            </div>
                        }
                        @if (Model.ZipPostalCodeEnabled)
                        {
                            <div class="inputs">
                                @Html.TextBoxFor(model => model.ZipPostalCode, new { placeholder = "Zip Code" })
                                @if (Model.ZipPostalCodeRequired)
                                {

                                }
                                @Html.ValidationMessageFor(model => model.ZipPostalCode)
                            </div>
                        }
                        @if (Model.CityEnabled)
                        {
                            <div class="inputs">
                                @Html.TextBoxFor(model => model.City, new { placeholder = "City" })
                                @if (Model.CityRequired)
                                {

                                }
                                @Html.ValidationMessageFor(model => model.City)
                            </div>
                        }
                        @if (Model.CountryEnabled)
                        {
                            <div class="inputs">

                                @Html.DropDownList("CountryId", Model.AvailableCountries)
                            </div>
                        }
                        @if (Model.CountryEnabled && Model.StateProvinceEnabled)
                        {
                            <div class="inputs">

                                @Html.DropDownList("StateProvinceId", Model.AvailableStates)
                                <span id="states-loading-progress" style="display: none;" class="please-wait">("Common.Wait...")</span>
                            </div>
                        }
                    </div>
                </div>
            }
            @if (Model.PhoneEnabled || Model.FaxEnabled)
            {
                <div class="fieldset">
                    <div class="title">
                        <strong>("Account.YourContactInformation")</strong>
                    </div>
                    <div class="form-fields">
                        @if (Model.PhoneEnabled)
                        {
                            <div class="inputs">
                                @Html.TextBoxFor(model => model.Phone, new { placeholder = "Phone" })
                                @if (Model.PhoneRequired)
                                {

                                }
                                @Html.ValidationMessageFor(model => model.Phone)
                            </div>
                        }
                        @if (Model.FaxEnabled)
                        {
                            <div class="inputs">
                                @Html.TextBoxFor(model => model.Fax, new { placeholder = "Fax" })

                                @if (Model.FaxRequired)
                                {

                                }
                                @Html.ValidationMessageFor(model => model.Fax)
                            </div>
                        }
                    </div>
                </div>
            }
            @if (Model.NewsletterEnabled || Model.CustomerAttributes.Count > 0)
            {
                <div class="fieldset">
                    <div class="title">
                        <strong>("Account.Options")</strong>
                    </div>
                    <div class="form-fields">
                        @if (Model.NewsletterEnabled)
                        {
                            <div class="inputs">


                                @Html.EditorFor(model => model.Newsletter)
                                @Html.ValidationMessageFor(model => model.Newsletter)
                            </div>
                        }
                        @if (Model.CustomerAttributes.Count > 0)
                        {
                            @Html.Partial("_CustomerAttributes", Model.CustomerAttributes)
                        }
                    </div>
                </div>
            }
            @if (Model.AllowCustomersToSetTimeZone)
            {
                <div class="fieldset">
                    <div class="title">
                        <strong>("Account.Preferences")</strong>
                    </div>
                    <div class="form-fields">
                        @if (Model.AllowCustomersToSetTimeZone)
                        {
                            <div class="inputs">

                                @Html.DropDownList("TimeZoneId", Model.AvailableTimeZones)
                                @Html.ValidationMessageFor(model => model.TimeZoneId)
                            </div>
                        }
                    </div>
                </div>
            }
            <div class="fieldset">
                <div class="title">
                    <strong>("Account.YourPassword")</strong>
                </div>
                <div class="form-fields">
                    <div class="inputs">
                        @Html.PasswordFor(model => model.Password, new { placeholder = "Password" })


                        @Html.ValidationMessageFor(model => model.Password)
                    </div>
                    <div class="inputs">
                        @Html.PasswordFor(model => model.ConfirmPassword, new { placeholder = "Confirm Password" })


                        @Html.ValidationMessageFor(model => model.ConfirmPassword)
                    </div>
                    @if (Model.DisplayCaptcha)
                    {
                        <div class="captcha-box">
                            @*@Html.Raw(Html.GenerateCaptcha())*@
                        </div>
                    }
                </div>
            </div>
            @* WC. Enable this when need (note that code should be moved to js file or it will not work)*@
            @*@if (Model.AcceptPrivacyPolicyEnabled)
                {
                    <script type="text/javascript">
                        $(document).ready(function () {
                            $('#register-button').click(function () {
                                if ($('#accept-privacy-policy').is(':checked')) {
                                    //do some stuff
                                    return true;
                                }
                                else {
                                    //just show validation errors, dont post
                                    alert('@Html.Raw(HttpUtility.JavaScriptStringEncode(T("Account.Fields.AcceptPrivacyPolicy.Required").Text))');
                                    return false;
                                }
                            });
                        });
                    </script>
                    <div class="accept-privacy-policy">
                        <input id="accept-privacy-policy" type="checkbox" name="accept-privacy-policy" />
                        <label for="accept-privacy-policy">@T("Account.Fields.AcceptPrivacyPolicy")</label>
                        <span class="read" onclick="javascript:OpenWindow('@Url.RouteUrl("TopicPopup", new { SystemName = "privacyinfo" })', 450, 500, true)">@T("Account.Fields.AcceptPrivacyPolicy.Read")</span>
                    </div>
                }*@
            <div class="buttons">
                <input type="submit" id="register-button" class="button-1 register-next-step-button" value="(" Account.Register.Button")" name="register-button" />
            </div>
        </div>
    </div>
}
