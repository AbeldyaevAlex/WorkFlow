@model WorkShopMemorandumBase
@using Asu.Web.Models;
@using Asu.Core;
@using Asu.Core.Infrastructure;
@{
    Layout = "~/Views/Shared/_LayoutKendo.cshtml";
    ViewBag.Title = "МСЗ";
}
<h2 align="center">МСЗ</h2>
    <div class="row table-responsive" style="padding-left: 0%">
            <div class="col-12">
                @(Html.Kendo().Grid<Asu.Web.Models.WorkShopMemorandumBase>()
                .Name("grid")
                .Columns(columns =>
                {
                    //columns.Command(command => { command.Edit(); }).Width(210);

                    columns.Bound(p => p.Id).Title("№ п/п").Filterable(true).Hidden(false).Width(100).Locked(true).HeaderHtmlAttributes(new { @class = "k-grid-header" }) ;
                    columns.Bound(p => p.tema).Title("Тема").Filterable(true).Hidden(true);
                    columns.Bound(p => p.zakaz).Title("Заказ").Filterable(true).Hidden(true).Width(600).HeaderHtmlAttributes(new { style = "overflow: visible; white-space: normal; text-align: center; background-color: #f5f5f5;" });
                    columns.Bound(p => p.no_sz).Title("№ С/З").Filterable(true).Width(200).Locked(true).HeaderHtmlAttributes(new { style = "overflow: visible; white-space: normal; text-align: center; font-weight: bold; font-family: 'Arial'; font-size: 14px; background-color: #f5f5f5;" })
                      .HtmlAttributes(new { style = "font-weight: bold; font-family: 'Arial'; font-size: 13px" });
                    columns.Bound(p => p.date).Title("Дата создания С / З").Format("{0:dd.MM.yyyy}").Width(180).Locked(true).HeaderHtmlAttributes(new { style = "overflow: visible; white-space: normal; text-align: center; font-weight: bold; font-family: 'Arial'; font-size: 14px; background-color: #f5f5f5;" });
                    columns.Bound(p => p.version).Title("Версия С/З").Filterable(true).Width(184).Locked(true).HeaderHtmlAttributes(new { style = "overflow: visible; white-space: normal; text-align: center; font-weight: bold; font-family: 'Arial'; font-size: 14px; background-color: #f5f5f5" });
                    columns.Bound(p => p.refcshortname).Title("Источник поступления").Filterable(true).Width(215).Locked(false).HeaderHtmlAttributes(new { style = "overflow: visible; white-space: normal; text-align: center; font-weight: bold; font-family: 'Arial'; font-size: 14px; background-color: #f5f5f5" });
                    columns.Bound(p => p.sostavitel).Title("Составитель С/З").Filterable(true).Width(225).HeaderHtmlAttributes(new { style = "overflow: visible; white-space: normal; text-align: center" }).HeaderHtmlAttributes(new { style = "overflow: visible; white-space: normal; text-align: center; font-weight: bold; font-family: 'Arial'; font-size: 14px; background-color: #f5f5f5" });
                    columns.Bound(p => p.osnovanie).Title("Документ снование").Filterable(true).Width(525).HeaderHtmlAttributes(new { style = "overflow: visible; white-space: normal; text-align: center" }).HeaderHtmlAttributes(new { style = "overflow: visible; white-space: normal; text-align: center; font-weight: bold; font-family: 'Arial'; font-size: 14px; background-color: #f5f5f5" });
                    columns.Bound(p => p.soderjanie).Title("Содержание С/З").Filterable(true).Width(840).HeaderHtmlAttributes(new { style = "overflow: visible; white-space: normal; text-align: center" }).HeaderHtmlAttributes(new { style = "overflow: visible; white-space: normal; text-align: center; font-weight: bold; font-family: 'Arial'; font-size: 14px; background-color: #f5f5f5" });
                    columns.Bound(p => p.status).Title("Статус С/З").Filterable(true).Width(300).HeaderHtmlAttributes(new { style = "overflow: visible; white-space: normal; text-align: center" }).HeaderHtmlAttributes(new { style = "overflow: visible; white-space: normal; text-align: center; font-weight: bold; font-family: 'Arial'; font-size: 14px; background-color: #f5f5f5" });
                    columns.Bound(p => p.cex_otprav).Title("Цех отправитель").Filterable(true).Width(205).HeaderHtmlAttributes(new { style = "overflow: visible; white-space: normal; text-align: center" }).HeaderHtmlAttributes(new { style = "overflow: visible; white-space: normal; text-align: center; font-weight: bold; font-family: 'Arial'; font-size: 14px; background-color: #f5f5f5" });
                    columns.Bound(p => p.sborka_montaj).Title("Сборка/монтаж").Filterable(true).Width(205).HeaderHtmlAttributes(new { style = "overflow: visible; white-space: normal; text-align: center" }).HeaderHtmlAttributes(new { style = "overflow: visible; white-space: normal; text-align: center; font-weight: bold; font-family: 'Arial'; font-size: 14px; background-color: #f5f5f5" });
                    columns.Bound(p => p.divisshortname).Title("Цех получатель").Filterable(true).Width(205).HeaderHtmlAttributes(new { style = "overflow: visible; white-space: normal; text-align: center" }).HeaderHtmlAttributes(new { style = "overflow: visible; white-space: normal; text-align: center; font-weight: bold; font-family: 'Arial'; font-size: 14px; background-color: #f5f5f5" });
                    columns.Bound(p => p.ogmet).Title("Согасование ОГМЕТ").Filterable(true).Width(105).ClientTemplate("<input type='checkbox'/>").HtmlAttributes(new { style = "text-align: center" })
                             .HeaderHtmlAttributes(new { style = "overflow: visible; white-space: normal; text-align: center; font-weight: bold; font-family: 'Arial'; font-size: 14px; background-color: #f5f5f5" });
                    columns.Bound(p => p.ogt).Title("Согасование ОГТ").Filterable(true).Width(105).ClientTemplate("<input type='checkbox'/>").HtmlAttributes(new { style = "text-align: center" })
                             .HeaderHtmlAttributes(new { style = "overflow: visible; white-space: normal; text-align: center; font-weight: bold; font-family: 'Arial'; font-size: 14px; background-color: #f5f5f5" });
                    columns.Bound(p => p.worklineno).Title("№ строки по С/З").Filterable(true).Width(205).HeaderHtmlAttributes(new { style = "overflow: visible; white-space: normal; text-align: center" }).HeaderHtmlAttributes(new { style = "overflow: visible; white-space: normal; text-align: center; font-weight: bold; font-family: 'Arial'; font-size: 14px; background-color: #f5f5f5" });
                    columns.Bound(p => p.level).Title("Уровень входимости").Filterable(true).Width(205).HeaderHtmlAttributes(new { style = "overflow: visible; white-space: normal; text-align: center" }).HeaderHtmlAttributes(new { style = "overflow: visible; white-space: normal; text-align: center; font-weight: bold; font-family: 'Arial'; font-size: 14px; background-color: #f5f5f5" });
                    columns.Bound(p => p.pkp).Title("ПКП").Filterable(true).Width(205).HeaderHtmlAttributes(new { style = "overflow: visible; white-space: normal; text-align: center; font-weight: bold; font-family: 'Arial'; font-size: 14px; background-color: #f5f5f5" });
                    columns.Bound(p => p.oboznach).Title("Обозначение ДСЕ").Filterable(true).Width(205).HeaderHtmlAttributes(new { style = "overflow: visible; white-space: normal; text-align: center" }).HeaderHtmlAttributes(new { style = "overflow: visible; white-space: normal; text-align: center; font-weight: bold; font-family: 'Arial'; font-size: 14px; background-color: #f5f5f5" });
                    columns.Bound(p => p.naim).Title("Наименование ДСЕ").Filterable(true).Width(550).HeaderHtmlAttributes(new { style = "overflow: visible; white-space: normal; text-align: center" }).HeaderHtmlAttributes(new { style = "overflow: visible; white-space: normal; text-align: center; font-weight: bold; font-family: 'Arial'; font-size: 14px; background-color: #f5f5f5" });
                    columns.Bound(p => p.eizm).Title("Еденица измерения").Filterable(true).Width(205).HeaderHtmlAttributes(new { style = "overflow: visible; white-space: normal; text-align: center" }).HeaderHtmlAttributes(new { style = "overflow: visible; white-space: normal; text-align: center; font-weight: bold; font-family: 'Arial'; font-size: 14px; background-color: #f5f5f5" });
                    columns.Bound(p => p.samplequantity).Title("Кол-во образцов").Filterable(true).Width(205).HeaderHtmlAttributes(new { style = "overflow: visible; white-space: normal; text-align: center" }).HeaderHtmlAttributes(new { style = "overflow: visible; white-space: normal; text-align: center; font-weight: bold; font-family: 'Arial'; font-size: 14px; background-color: #f5f5f5" });
                    columns.Bound(p => p.quantity).Title("Кол - во ДСЕ").Filterable(true).Width(205).HeaderHtmlAttributes(new { style = "overflow: visible; white-space: normal; text-align: center" }).HeaderHtmlAttributes(new { style = "overflow: visible; white-space: normal; text-align: center; font-weight: bold; font-family: 'Arial'; font-size: 14px; background-color: #f5f5f5" });
                    columns.Bound(p => p.productdesignationparent).Title("КТС родитель").Filterable(true).Width(205).HeaderHtmlAttributes(new { style = "overflow: visible; white-space: normal; text-align: center" }).HeaderHtmlAttributes(new { style = "overflow: visible; white-space: normal; text-align: center; font-weight: bold; font-family: 'Arial'; font-size: 14px; background-color: #f5f5f5" });
                    columns.Bound(p => p.productnameparent).Title("Наименование КТС родитель").Filterable(true).Width(550).HeaderHtmlAttributes(new { style = "overflow: visible; white-space: normal; text-align: center" }).HeaderHtmlAttributes(new { style = "overflow: visible; white-space: normal; text-align: center; font-weight: bold; font-family: 'Arial'; font-size: 14px; background-color: #f5f5f5" });
                    columns.Bound(p => p.rascehov).Title("Расцеховка").Filterable(true).Width(205).HeaderHtmlAttributes(new { style = "overflow: visible; white-space: normal; text-align: center" }).HeaderHtmlAttributes(new { style = "overflow: visible; white-space: normal; text-align: center; font-weight: bold; font-family: 'Arial'; font-size: 14px; background-color: #f5f5f5" });
                    columns.Bound(p => p.tex_usl).Title("Тех. условия изготовления ДСЕ").Filterable(true).Width(410).HeaderHtmlAttributes(new { style = "overflow: visible; white-space: normal; text-align: center" }).HeaderHtmlAttributes(new { style = "overflow: visible; white-space: normal; text-align: center; font-weight: bold; font-family: 'Arial'; font-size: 14px; background-color: #f5f5f5" });
                    columns.Bound(p => p.materialquantity).Title("Норма расхода материала").Filterable(true).Width(205).HeaderHtmlAttributes(new { style = "overflow: visible; white-space: normal; text-align: center" }).HeaderHtmlAttributes(new { style = "overflow: visible; white-space: normal; text-align: center; font-weight: bold; font-family: 'Arial'; font-size: 14px; background-color: #f5f5f5" });
                    columns.Bound(p => p.operationname).Title("Тип операции").Filterable(true).Width(205).HeaderHtmlAttributes(new { style = "overflow: visible; white-space: normal; text-align: center" }).HeaderHtmlAttributes(new { style = "overflow: visible; white-space: normal; text-align: center; font-weight: bold; font-family: 'Arial'; font-size: 14px; background-color: #f5f5f5" });
                    columns.Bound(p => p.cex_izgotov).Title("Цеха изготовители").Filterable(true).Width(205).HeaderHtmlAttributes(new { style = "overflow: visible; white-space: normal; text-align: center" }).HeaderHtmlAttributes(new { style = "overflow: visible; white-space: normal; text-align: center; font-weight: bold; font-family: 'Arial'; font-size: 14px; background-color: #f5f5f5" });
                    columns.Bound(p => p.cex_usl).Title("Цеха услуг").Filterable(true).Width(205).HeaderHtmlAttributes(new { style = "overflow: visible; white-space: normal; text-align: center" }).HeaderHtmlAttributes(new { style = "overflow: visible; white-space: normal; text-align: center; font-weight: bold; font-family: 'Arial'; font-size: 14px; background-color: #f5f5f5" });
                    columns.Bound(p => p.materialsize).Title("Размер заготовки").Filterable(true).Width(205).HeaderHtmlAttributes(new { style = "overflow: visible; white-space: normal; text-align: center" }).HeaderHtmlAttributes(new { style = "overflow: visible; white-space: normal; text-align: center; font-weight: bold; font-family: 'Arial'; font-size: 14px; background-color: #f5f5f5" });
                    columns.Bound(p => p.nomenclatureno).Title("Код материала").Filterable(true).Width(205).HeaderHtmlAttributes(new { style = "overflow: visible; white-space: normal; text-align: center" }).HeaderHtmlAttributes(new { style = "overflow: visible; white-space: normal; text-align: center; font-weight: bold; font-family: 'Arial'; font-size: 14px; background-color: #f5f5f5" });
                    columns.Bound(p => p.namemater).Title("Наименование материала").Filterable(true).Width(405).HeaderHtmlAttributes(new { style = "overflow: visible; white-space: normal; text-align: center" }).HeaderHtmlAttributes(new { style = "overflow: visible; white-space: normal; text-align: center; font-weight: bold; font-family: 'Arial'; font-size: 14px; background-color: #f5f5f5" });
                    columns.Bound(p => p.materialmark).Title("Марка материала").Filterable(true).Width(205).HeaderHtmlAttributes(new { style = "overflow: visible; white-space: normal; text-align: center" }).HeaderHtmlAttributes(new { style = "overflow: visible; white-space: normal; text-align: center; font-weight: bold; font-family: 'Arial'; font-size: 14px; background-color: #f5f5f5" });
                    columns.Bound(p => p.standard).Title("ГОСТ/ТУ").Filterable(true).Width(205).HeaderHtmlAttributes(new { style = "overflow: visible; white-space: normal; text-align: center" }).HeaderHtmlAttributes(new { style = "overflow: visible; white-space: normal; text-align: center; font-weight: bold; font-family: 'Arial'; font-size: 14px; background-color: #f5f5f5" });
                    columns.Bound(p => p.diameter).Title("Диаметр, толщина материала").Filterable(true).Width(205).HeaderHtmlAttributes(new { style = "overflow: visible; white-space: normal; text-align: center" }).HeaderHtmlAttributes(new { style = "overflow: visible; white-space: normal; text-align: center; font-weight: bold; font-family: 'Arial'; font-size: 14px; background-color: #f5f5f5" });
                    columns.Bound(p => p.dimension).Title("Длина, ширина материала").Filterable(true).Width(205).HeaderHtmlAttributes(new { style = "overflow: visible; white-space: normal; text-align: center" }).HeaderHtmlAttributes(new { style = "overflow: visible; white-space: normal; text-align: center; font-weight: bold; font-family: 'Arial'; font-size: 14px; background-color: #f5f5f5" });
                })
                .Pageable()
                .Sortable()
                .Scrollable()
                .Filterable()
                .Selectable()
                .Groupable()
                .ToolBar(tools =>
                {
                    tools.Excel();
                    tools.Create();
                    tools.Custom()
                    .Name("duplicate")
                    .Text("Номенклатура МСЗ")
                    .HtmlAttributes(new { target = "_blank" })
                    .Url(Url.Action("NomenklMsz", "MainMalahit"));
                })
                .Editable(editable => editable.Mode(GridEditMode.InLine))
                .Resizable(resize => resize.Columns(true))
                .HtmlAttributes(new { style = "height:900px;" })
                .DataSource(dataSource => dataSource
                    .Ajax().Model(model =>
                    {
                        model.Id(p => p.Id);
                    })
                    .Group(groups => groups.Add(p => p.tema))
                    .Group(groups => groups.Add(p => p.zakaz))
                    .PageSize(500)
                    .Read(read => read.Action("Orders_Read", "MainMalahit"))
                    .Create(Create => Create.Action("Orders_Read", "MainMalahit"))
                )
            )
            </div>
        </div>

