@model AccumulativememorandumVM
@using Asu.Web.Models;
@using Asu.Core;
@using Asu.Core.Infrastructure;
@{
    Layout = "~/Views/Shared/_LayoutKendoForGrid.cshtml";
    ViewBag.Title = "Накопительные МСЗ";
}
<h2 align="center">Накопительные МСЗ</h2>
<div class="row table-responsive" style="padding-left: 0%">
    <div class="col-12">
        @(Html.Kendo().Grid<Asu.Web.Models.AccumulativememorandumVM>()
                .Name("gridAccumulative")
                .Columns(columns =>
                {
                    columns.Bound(p => p.no_sz).Title("№ С/З").Filterable(true).Width(200).Locked(false).HeaderHtmlAttributes(new { style = "overflow: visible; white-space: normal; text-align: center; font-weight: bold; font-family: 'Arial'; font-size: 14px" })
                      .HtmlAttributes(new { style = "font-weight: bold; font-family: 'Arial'; font-size: 13px" });
                    columns.Bound(p => p.accumulativeno).Title("№ Накопительной СЗ").Filterable(true).Width(205).HeaderHtmlAttributes(new { style = "overflow: visible; white-space: normal; text-align: center" }).HeaderHtmlAttributes(new { style = "overflow: visible; white-space: normal; text-align: center; font-weight: bold; font-family: 'Arial'; font-size: 14px" });
                    columns.Bound(p => p.status).Title("Статус СЗ").Filterable(true).Width(205).HeaderHtmlAttributes(new { style = "overflow: visible; white-space: normal; text-align: center" }).HeaderHtmlAttributes(new { style = "overflow: visible; white-space: normal; text-align: center; font-weight: bold; font-family: 'Arial'; font-size: 14px" });
                })
                .Pageable()
                .Sortable()
                .Scrollable()
                .Filterable()
                .Selectable()
                .Groupable()
                .ToolBar(tools =>
                {
                    tools.Excel();
                    //tools.Create();
                    //tools.Custom()
                    //.Name("duplicate")
                    //.Text("Номенклатура МСЗ")
                    //.HtmlAttributes(new { target = "_blank" })
                    //.Url(Url.Action("NomenklMsz", "MainMalahit"));
                })
                .Resizable(resize => resize.Columns(true))
                .HtmlAttributes(new { style = "height:900px;" })
                .DataSource(dataSource => dataSource
                    .Ajax()
                    //.Group(groups => groups.Add(p => p.tema))
                    //.Group(groups => groups.Add(p => p.zakaz))
                    .PageSize(500)
                    .Read(read => read.Action("Accumulativememorandum_Read", "MainMalahit"))
                )
            )
    </div>
</div>



