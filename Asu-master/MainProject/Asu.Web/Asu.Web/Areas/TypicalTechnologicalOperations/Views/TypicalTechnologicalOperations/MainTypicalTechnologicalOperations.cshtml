@using System.Web.UI.WebControls
@using DevExpress.Web.Mvc
@using Asu.Web.Models
@using Asu.Web.Areas.TypicalTechnologicalOperations.Controllers
@using System.Web.UI.WebControls
@using Asu.Core;
@using Asu.Core.Infrastructure;
@using Asu.Core.Domain.Customers
@model TtoViewModel
@{
    ViewBag.Title = "Справочник ТТО";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<h2 align="center" ; style="padding:50px 0 0 0">Справочник типовых технологических операций (ТТО).</h2>
<script type="text/javascript">
    function OnFocusedRowChanged(s, e) {
        pc.SetActiveTabIndex(1);
        gvTTO.PerformCallback();
    }
    function OnActiveTabChanged(s, e) {
        gvTTO.PerformCallback();
    }
    function OnBeginCallback(s, e) {
        e.customArgs["MasterRowKey"] = gvUniq.GetRowKey(gvUniq.GetFocusedRowIndex());
    }
    function OnCellClick(visibleIndex, fieldName) {
        debugger;
        alert(visibleIndex + ' ' + fieldName);
    }

</script>
@functions{
    private void AssignTextBoxSettings(TextBoxSettings s)
    {
        s.Width = Unit.Percentage(100);
        s.ShowModelErrors = true;
        s.Properties.ValidationSettings.Display = Display.Dynamic;
        s.Properties.ValidationSettings.SetFocusOnError = true;
        s.Properties.ValidationSettings.ErrorTextPosition = ErrorTextPosition.Bottom;
        s.Properties.ValidationSettings.ErrorDisplayMode = ErrorDisplayMode.ImageWithText;
        s.Properties.ValidationSettings.ErrorFrameStyle.Wrap = DefaultBoolean.True;
    }
}


@Html.DevExpress().PageControl(settings =>
{
    settings.Name = "pc";
    settings.Width = Unit.Percentage(100);
    settings.TabPages.Add("Типовые Технологические Операции").SetContent(() =>
    {
        Html.RenderPartial("_GridViewPartialUniq", Model.UniqKodKomp);
    });
    settings.TabPages.Add("Компоненты ТТО").SetContent(() =>
    {
        ViewContext.Writer.Write("<h1> Компоненты ТТО:</h1>" /*+ @Session["TipicalTehnOper"]*/);

        Html.RenderPartial("_GridViewPartialTTO", Model.SprTto);
    });
    settings.EnableClientSideAPI = true;
    settings.ClientSideEvents.ActiveTabChanged = "OnActiveTabChanged";
}).GetHtml()

