                text_nrm.Properties.HelpText = "Кратность";
            }).GetHtml();

            ViewContext.Writer.Write("<hr/>");

            Html.DevExpress().SpinEdit(text_nrm =>
            {
                text_nrm.Name = "vpost_sh";
                text_nrm.Properties.AllowMouseWheel = true;
                //text_nrm.Properties.SelectInputTextOnClick = true;
                //text_nrm.Properties.DisplayFormatString = "0";
                text_nrm.Width = Unit.Pixel(650);
                text_nrm.ShowModelErrors = true;
                text_nrm.ControlStyle.CssClass = "form_vpost_sh";
                text_nrm.Properties.HelpText = "Вид поставки от ширины";
            }).GetHtml();


            ViewContext.Writer.Write("</br>");

            Html.DevExpress().Button(button =>
            {
                button.Text = "Создать";
                button.Name = "Create";
                button.UseSubmitBehavior = true;
            }).GetHtml();
        }
    });
    settings.ClientSideEvents.CloseUp = "function(s, e){ ASPxClientEdit.ClearEditorsInContainer(null, '', true); }";
}).GetHtml()
