@functions{
    private void AssignTextBoxSettings(TextBoxSettings s)
    {
        s.Width = Unit.Percentage(100);
        s.ShowModelErrors = true;
        s.Properties.ValidationSettings.Display = Display.Dynamic;
        s.Properties.ValidationSettings.SetFocusOnError = true;
        s.Properties.ValidationSettings.ErrorTextPosition = ErrorTextPosition.Bottom;
        s.Properties.ValidationSettings.ErrorDisplayMode = ErrorDisplayMode.ImageWithText;
        s.Properties.ValidationSettings.ErrorFrameStyle.Wrap = DefaultBoolean.True;
    }
}


@Html.DevExpress().PageControl(settings =>
{
settings.Name = "pc";
settings.Width = Unit.Percentage(100);
settings.TabPages.Add("Типовые Технологические Операции").SetContent(() =>
{
    Html.RenderPartial("_GridViewPartialUniq", Model.Uniq_link_komp);
});
settings.TabPages.Add("Компоненты ТТО").SetContent(() =>
{
    ViewContext.Writer.Write("<h1> Компоненты ТТО:</h1>" + @Session["TipicalTehnOper"]);

    Html.RenderPartial("_GridViewPartialTTO", Model.Spr_tto);
});
settings.EnableClientSideAPI = true;
settings.ClientSideEvents.ActiveTabChanged = "OnActiveTabChanged";
}).GetHtml()

@Html.DevExpress().PopupControl(settings =>
{
    settings.ShowFooter = true;
