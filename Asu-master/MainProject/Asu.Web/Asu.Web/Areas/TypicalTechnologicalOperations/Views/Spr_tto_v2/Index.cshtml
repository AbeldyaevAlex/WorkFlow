                Combo.Properties.DropDownStyle = DropDownStyle.DropDown;
                Combo.Properties.IncrementalFilteringMode = IncrementalFilteringMode.Contains;
                Combo.ToolTip = "Код ТТО";
                Combo.Width = Unit.Pixel(650);
                Combo.Properties.ValueField = "Id";
