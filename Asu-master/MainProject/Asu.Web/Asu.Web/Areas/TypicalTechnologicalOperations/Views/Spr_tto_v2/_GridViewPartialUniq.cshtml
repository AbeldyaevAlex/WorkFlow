@using System.Web.UI.WebControls
@using DevExpress.Web.Mvc
@using Asu.Web.Models
@*@using System.Data.Entity*@


@Html.DevExpress().GridView(settings =>
{
    Html.EnableClientValidation();
    Html.EnableUnobtrusiveJavaScript();

    settings.EnableRowsCache = false;

    settings.Name = "gvUniq";
    settings.CallbackRouteValues = new { Controller = "Spr_tto_v2", Action = "GridViewPartialUniq" };
    //settings.SettingsEditing.UpdateRowRouteValues = new { Controller = "Spr_tto_v2", Action = "GridViewPartial_TTOUpdate" };
    settings.SettingsEditing.DeleteRowRouteValues = new { Controller = "Spr_tto_v2", Action = "GridViewPartial_TTODelete" };
    settings.SettingsEditing.Mode = GridViewEditingMode.EditFormAndDisplayRow;
    settings.KeyFieldName = "link_kod_tto";

    settings.Settings.VerticalScrollBarMode = ScrollBarMode.Auto;
    settings.Settings.VerticalScrollableHeight = 550;
    settings.Settings.HorizontalScrollBarMode = ScrollBarMode.Auto;

    settings.Width = Unit.Percentage(100);
    settings.SettingsBehavior.AllowEllipsisInText = true;
    settings.SettingsBehavior.AllowDragDrop = true;

    settings.SettingsPager.PageSize = 20;
    settings.SettingsPager.EnableAdaptivity = false;
    settings.SettingsPager.PageSizeItemSettings.Visible = true;
    settings.SettingsPager.Visible = true;
    settings.Settings.ShowGroupPanel = true;
    settings.Settings.ShowFilterRow = true;
    settings.CommandColumn.Width = Unit.Pixel(175);
    settings.CommandColumn.Visible = true;
    settings.CommandColumn.ShowNewButton = false;


    settings.CommandColumn.CellStyle.Wrap = DefaultBoolean.True;

    settings.SettingsCustomizationDialog.Enabled = true;

    GridViewCommandColumnCustomButton custombuttonAddTTO = new GridViewCommandColumnCustomButton() { Text = "Добавить " };
    settings.CommandColumn.CustomButtons.Add(custombuttonAddTTO);
    custombuttonAddTTO.Image.IconID = IconID.ActionsAdd16x16;
    custombuttonAddTTO.Image.ToolTip = "Создать ТТО";
    settings.ClientSideEvents.CustomButtonClick = "function(s, e) { pcModalModeAddTTO.Show(); }";

    settings.CommandColumn.ShowDeleteButton = true;
    settings.SettingsCommandButton.DeleteButton.Image.IconID = IconID.IconbuilderActionsDeleteSvgGray16x16;
    settings.SettingsCommandButton.DeleteButton.Text = "Удалить";
    settings.SettingsCommandButton.DeleteButton.Styles.Style.Width = Unit.Pixel(80);
    settings.SettingsCommandButton.DeleteButton.Image.Width = Unit.Pixel(12);
    settings.SettingsCommandButton.DeleteButton.Styles.Style.Spacing = Unit.Pixel(50);
    settings.SettingsCommandButton.DeleteButton.Image.Height = Unit.Pixel(12);

    //settings.CommandColumn.ShowEditButton = true;
    //settings.SettingsCommandButton.EditButton.Image.IconID = IconID.ActionsInsert16x16;
    //settings.SettingsCommandButton.EditButton.Text = "Изменить";
    //settings.SettingsCommandButton.EditButton.Styles.Style.Width = Unit.Pixel(80);
    //settings.SettingsCommandButton.EditButton.Styles.Style.Spacing = Unit.Pixel(50);
    //settings.SettingsCommandButton.EditButton.Image.Width = Unit.Pixel(12);
    //settings.SettingsCommandButton.EditButton.Image.Height = Unit.Pixel(12);


    settings.SettingsAdaptivity.AdaptivityMode = GridViewAdaptivityMode.Off;
    settings.SettingsAdaptivity.AdaptiveColumnPosition = GridViewAdaptiveColumnPosition.Right;
    settings.SettingsAdaptivity.AdaptiveDetailColumnCount = 1;
    settings.SettingsAdaptivity.AllowOnlyOneAdaptiveDetailExpanded = false;
    settings.SettingsAdaptivity.HideDataCellsAtWindowInnerWidth = 0;

    settings.SettingsResizing.ColumnResizeMode = ColumnResizeMode.Control;
    settings.SettingsResizing.Visualization = ResizingMode.Postponed;
    settings.SettingsBehavior.AllowEllipsisInText = true;

    settings.ControlStyle.Border.BorderColor = System.Drawing.Color.Black;
    settings.ControlStyle.Border.BorderStyle = BorderStyle.Solid;
    settings.ControlStyle.Border.BorderWidth = 1;
    //settings.Columns.Add(column =>
    //{
    //    column.FieldName = "dsh";
    //    column.Caption = "Признак ТТО";
    //    column.Width = Unit.Pixel(70);
    //    column.CellStyle.Wrap = DefaultBoolean.True;
    //    column.HeaderStyle.Wrap = DefaultBoolean.True;
    //    column.HeaderStyle.HorizontalAlign = HorizontalAlign.Center;
    //    column.HeaderStyle.CssClass = "header";
    //});
    settings.Columns.Add(column =>
    {
        column.FieldName = "link_kod_tto";
        column.Visible = false;
    });
    settings.Columns.Add(column =>
    {
        column.FieldName = "km";
        column.Caption = "Код ТТО";
        column.Width = Unit.Pixel(120);
        column.CellStyle.Wrap = DefaultBoolean.True;
        column.HeaderStyle.Wrap = DefaultBoolean.True;
        column.HeaderStyle.HorizontalAlign = HorizontalAlign.Center;
        column.HeaderStyle.CssClass = "header";
        //column.SetHeaderTemplateContent(c => {
        //    ViewContext.Writer.Write("<span style='font-weight: 800'>" + c.Column.Caption + "</span>");
        //});       
    });
    settings.Columns.Add(columnSettings =>
