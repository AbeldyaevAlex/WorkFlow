    settings.Toolbars.Add(toolbar =>
    {
        toolbar.Enabled = true;
        toolbar.Position = GridToolbarPosition.Top;
        toolbar.ItemAlign = GridToolbarItemAlign.Left;
        toolbar.Items.Add(item =>
        {
            item.Command = GridViewToolbarCommand.ShowCustomizationDialog;
            item.Text = "Панель Группировки";
            item.Image.IconID = IconID.ActionsFilter16x16devav;
        });
        toolbar.Items.Add(item =>
        {
            item.Command = GridViewToolbarCommand.ShowSearchPanel;
            item.Text = "Расширенный поиск";
            item.Image.IconID = IconID.ActionsChangeview16x16devav;
        });
        //toolbar.Items.Add(item =>
        //{
        //    item.NavigateUrl = Url.Action("ShowDeletetedRow", "Spr_skm");
        //    item.Text = "Показать удаленные";
        //    item.Image.IconID = IconID.HybriddemoiconsBottompanelHybriddemoCancelSvg16x16;
        //});
    });
    settings.SettingsBehavior.AllowFocusedRow = true;
    settings.SettingsBehavior.AllowClientEventsOnLoad = false;
    settings.ClientSideEvents.RowDblClick = "OnFocusedRowChanged";
}).Bind(Model).GetHtml()
