        columnSettings.FieldName = "link_prpokr";
        var x = columnSettings.Caption = "Признак покрытия";
        //columnSettings.GroupIndex = 0;
        columnSettings.Visible = true;
        columnSettings.Width = Unit.Pixel(200);
        columnSettings.ColumnType = MVCxGridViewColumnType.ComboBox;
        var comboBoxProperties = columnSettings.PropertiesEdit as ComboBoxProperties;
        comboBoxProperties.ValueField = "Id";
        comboBoxProperties.TextField = "prpokr";
        columnSettings.CellStyle.Wrap = DefaultBoolean.True;
        columnSettings.HeaderStyle.Wrap = DefaultBoolean.True;
        columnSettings.HeaderStyle.HorizontalAlign = HorizontalAlign.Center;
        columnSettings.HeaderStyle.CssClass = "header";
        comboBoxProperties.ValueType = typeof(string);
        comboBoxProperties.DataSource = Asu.Web.Controllers.DropDownCollectionController.Get_Pr_Pokr();
    });
    settings.Columns.Add(column =>
