@using Asu.Core
@using Asu.Core.Infrastructure
@{
    ViewBag.Title = "Метрология и Стандартизация (Калибровка, Поверка, Проверка)";

    Layout = "~/Areas/Metrology/Views/Shared/_mainLayout.cshtml";
}

@{
    int hour = DateTime.Now.Hour;
    var customerName = EngineContext.Current.Resolve<IWorkContext>().CurrentCustomer.ShippingAddress.FullName;
    var Greeting = hour < 12 ? "     Доброе утро, " + customerName + " !" : hour < 17 ? "     Добрый день, " + customerName + " !" : "     Добрый вечер, " + customerName + " !";
}
<div class="container body-content">
    <style>
        p {
            text-indent: 25px;
        }
    </style>

    <p style="align-content:center">
        <h2>&nbsp;&nbsp;&nbsp; @Greeting</h2>       <h4> &nbsp;&nbsp;&nbsp;&nbsp;&nbsp; Вы находитесь на странице &rdquo;@ViewBag.Title&rdquo;</h4>
    </p>
    <br>
    <br>
    <br>
    <br>
    <br>
    <div style="text-align:center ; align-items:center">
        <h1>
            Ведение справочника
            <br>
            &rdquo;Метрология&rdquo;
        </h1>
    </div>
    <br>
    <br>
    <br>
    <br>
    <br>
    <br>

    <div style="padding:20px;">
        <p>
            <big>
                Метрология необходима для стандартизации и унификации международных связей в сфере науки, промышленности, медицины, торговли и т.д. Одной из целей метрологии является
                обеспечение единства измерений.
            </big>
        </p>
        <p>
            <big>
                Если говорить простым языком, метрология занимается вопросами измерения физических величин, характеризующих всевозможные объекты, процессы или явления.
                В сферу ее интересов входит разработка и практическое применение измерительных технологий, инструмента и оборудования, а также средств и методов обработки
                полученной информации.
            </big>
        </p>
        <p>
            <big>
                Велико значение измерений в современном обществе. Они служат не только основой научно-технических знаний, но имеют первостепенное значение для учета материальных ресурсов и
                планирования, для внутренней и внешней торговли, для обеспечения качества продукции, взаимозаменяемости узлов и деталей и совершенчтвования технологии, для обеспечения
                безопасности труда и других видов человеческой деятельности.
            </big>
        </p>
        <p>
            <big>
                Промышленная метрология связана с измерениями на производстве и с процедурами управления качеством. Типичные вопросы - это процедуры и интервалы калибровки, контроль за
                процессами измерений, и управление измерительным оборудованием.
            </big>
        </p>
        <p>
            <big>
                Справочник &rdquo; Метрология &rdquo; содержит указанные сведения об измерительном оборудовании. Он позволяет просматривать необходимую информацию и использовать
                содержащиеся сведения для контроля и отслеживания сосотояния заводского оборудования.
            </big>
        </p>
    </div>
    <br>
    <br>
    <br>
    <br>
    <br>
    <br>
    <br>
    <br>
    <br>
    <br>
    <br>
    <br>
    <br>
    <br>
    <br>
</div>


