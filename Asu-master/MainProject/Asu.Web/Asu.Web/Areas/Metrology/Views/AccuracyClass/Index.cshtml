    settings.ToolTip = "Экспорт информации из справочника классов точности приборов в Excel формат XLSX";
    settings.Modal = true;
    settings.AutoUpdatePosition = true;
    settings.PopupHorizontalAlign = PopupHorizontalAlign.WindowCenter;
    settings.PopupVerticalAlign = PopupVerticalAlign.WindowCenter;
    settings.SetContent(() =>
        {
            using (Html.BeginForm("Export", "AccuracyClass", FormMethod.Post, new { id = "popupForm", @class = "edit_form" }))
            {
