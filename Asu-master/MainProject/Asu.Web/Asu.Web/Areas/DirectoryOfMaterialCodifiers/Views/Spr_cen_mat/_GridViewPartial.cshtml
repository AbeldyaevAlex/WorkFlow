@using System.Web.UI.WebControls
@using DevExpress.Web.Mvc
@{
    var grid = Html.DevExpress().GridView(settings => {
        settings.Name = "detailGrid" + ViewData["cena_mater"];
        settings.CallbackRouteValues = new { Controller = "Spr_cen_mat", Action = "GridViewPartial", cena = ViewData["cena_mater"] };

        settings.SettingsEditing.AddNewRowRouteValues = new { Controller = "Spr_cen_mat", Action = "GridViewPartialAddNew", cena = ViewData["cena_mater"] };
        settings.SettingsEditing.UpdateRowRouteValues = new { Controller = "Spr_cen_mat", Action = "GridViewPartialUpdate", cena = ViewData["cena_mater"] };
        settings.SettingsEditing.DeleteRowRouteValues = new { Controller = "Spr_cen_mat", Action = "GridViewPartialDelete", cena = ViewData["cena_mater"] };
        settings.SettingsEditing.Mode = GridViewEditingMode.EditFormAndDisplayRow;
        settings.SettingsBehavior.ConfirmDelete = true;

        settings.CommandColumn.Visible = true;
        settings.CommandColumn.Width = Unit.Pixel(75);

        settings.CommandColumn.ShowNewButton = true;
        settings.SettingsCommandButton.NewButton.Image.Url = "~/Content/Images/plus.ico";
        settings.SettingsCommandButton.NewButton.Text = " ";
        settings.SettingsCommandButton.NewButton.Image.Width = Unit.Pixel(12);
        settings.SettingsCommandButton.NewButton.Image.Height = Unit.Pixel(12);

