<script type="text/javascript">
    function OnToolbarItemClick(s, e) {
        switch (e.item.name) {
            case "nextPage":
                s.NextPage();
                break;
            case "previousPage":
                s.PrevPage();
                break;
            case "filterDate":
                pcModalMode.Show();
                break;
        }
    }
</script>
