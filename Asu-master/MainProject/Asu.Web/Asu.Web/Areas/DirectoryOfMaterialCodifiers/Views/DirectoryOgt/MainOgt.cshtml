    <script type="text/javascript">
        $(document).ready(function () {
            $("#GridViewOgt").on("dblclick", "tr", function () {
                debugger;
                var id = GridViewOgt.GetRowKey(GridViewOgt.GetFocusedRowIndex());
                /*var id = $(this).find('td:first').text();*/
                window.location.href = "Test?ogtId=" + id;
            });
        });
    </script>
    <script type="text/javascript">
        function OnToolbarItemClick(s, e) {
            switch (e.item.name) {
                case "nextPage":
                    s.NextPage();
                    break;
                case "previousPage":
                    s.PrevPage();
                    break;
                case "filterDate":
                    pcModalMode.Show();
                    break;
            }
        }
    </script>
    <script type="text/javascript">
        var command;
        var isNewRow;
        function onBeginCallback(s, e) {
            command = e.command;
            isNewRow = s.IsNewRowEditing();
            //var filter = {};

            //for (var i = 0; i < s.GetColumnsCount(); i++) {
