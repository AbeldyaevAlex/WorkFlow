@using System.Web.UI.WebControls
@using DevExpress.Web.Mvc
@*<link href="~/Content/GridView.css" rel="stylesheet" />*@
@{

    Html.EnableClientValidation();
    Html.EnableUnobtrusiveJavaScript();

    var grid = Html.DevExpress().GridView(settings =>
    {
        settings.Name = "GridViewOgt";
        settings.CallbackRouteValues = new { Controller = "Spr_Ogt", Action = "OgtDirectoryGridViewPartial" };

        settings.SettingsEditing.AddNewRowRouteValues = new { Controller = "Spr_Ogt", Action = "OgtDirectoryGridViewPartialAddNew" };
        settings.SettingsEditing.UpdateRowRouteValues = new { Controller = "Spr_Ogt", Action = "OgtDirectoryGridViewPartialUpdate" };
        settings.SettingsEditing.DeleteRowRouteValues = new { Controller = "Spr_Ogt", Action = "OgtDirectoryGridViewPartialDelete" };
        settings.SettingsEditing.Mode = GridViewEditingMode.EditFormAndDisplayRow;
        settings.SettingsBehavior.ConfirmDelete = false;

        settings.CommandColumn.Visible = true;


        settings.SettingsEditing.Mode = GridViewEditingMode.EditFormAndDisplayRow;
        settings.SettingsEditing.Mode = GridViewEditingMode.PopupEditForm;
        settings.SettingsEditing.EditFormColumnCount = 2;

        settings.SettingsBehavior.AutoExpandAllGroups = true;
        settings.SettingsBehavior.AllowSelectByRowClick = true;
        settings.SettingsBehavior.AllowFocusedRow = true;
        settings.SettingsBehavior.AllowEllipsisInText = true;
        settings.SettingsBehavior.AllowDragDrop = true;
        settings.SettingsBehavior.MergeGroupsMode = GridViewMergeGroupsMode.Disabled;

        settings.Width = System.Web.UI.WebControls.Unit.Percentage(100);

        settings.SettingsPager.PageSize = 25;
        settings.SettingsPager.EnableAdaptivity = true;
        settings.SettingsPager.PageSizeItemSettings.Visible = true;
        settings.SettingsPager.Visible = true;



        settings.CommandColumn.Visible = true;
        settings.CommandColumn.Width = Unit.Pixel(250);
        settings.CommandColumn.ShowNewButton = true;
        settings.SettingsCommandButton.NewButton.Image.Url = "~/Content/Images/plus.ico";
        settings.SettingsCommandButton.NewButton.Text = " ";
        settings.SettingsCommandButton.NewButton.Image.Width = Unit.Pixel(12);
        settings.SettingsCommandButton.NewButton.Image.Height = Unit.Pixel(12);

        settings.CommandColumn.ShowDeleteButton = true;
        settings.SettingsCommandButton.DeleteButton.Image.Url = "~/Content/Images/cancl_16.ico";
        settings.SettingsCommandButton.DeleteButton.Text = " ";
        settings.SettingsCommandButton.DeleteButton.Image.Width = Unit.Pixel(12);
        settings.SettingsCommandButton.DeleteButton.Image.Height = Unit.Pixel(12);

        settings.CommandColumn.ShowEditButton = true;
        settings.SettingsCommandButton.EditButton.Image.Url = "~/Content/Images/edit.ico";
        settings.SettingsCommandButton.EditButton.Text = " ";
        settings.SettingsCommandButton.EditButton.Image.Width = Unit.Pixel(14);
        settings.SettingsCommandButton.EditButton.Image.Height = Unit.Pixel(14);
        settings.CommandColumn.ButtonRenderMode = GridCommandButtonRenderMode.Secondary;

        GridViewCommandColumnCustomButton submitButton = new GridViewCommandColumnCustomButton() { ID = "btnDetail", Text = " "};
        submitButton.Image.Url = "~/Content/Images/cancl_16.ico";
        //settings.SettingsCommandButton.DeleteButton.Image.Url = "~/Content/Images/cancl_16.ico";
        settings.CommandColumn.CustomButtons.Add(submitButton);
        submitButton.Image.Width = Unit.Pixel(12);
        submitButton.Image.Height = Unit.Pixel(12);
        settings.ClientSideEvents.CustomButtonClick = string.Format("function(s, e) {{ if(e.buttonID == 'btnDetail') window.location.href = '{0}' }}", DevExpressHelper.GetUrl(new { Controller = "Spr_eizm", Action = "Index" }));
        //settings.ClientSideEvents.CustomButtonClick = string.Format(Url.Action("Spr_eizm", "Index", "DirectoryOfMaterialCodifiers_default"));







        settings.Settings.ShowGroupPanel = true;
        settings.Settings.ShowHeaderFilterButton = true;
        settings.Settings.EnableFilterControlPopupMenuScrolling = true;
        settings.Settings.ShowFilterRowMenuLikeItem = true;
        settings.Settings.ShowStatusBar = GridViewStatusBarMode.Auto;
        settings.Settings.ShowFilterRow = true;

        settings.SettingsAdaptivity.AdaptivityMode = GridViewAdaptivityMode.Off;
        settings.SettingsAdaptivity.AdaptiveColumnPosition = GridViewAdaptiveColumnPosition.Right;
        settings.SettingsAdaptivity.AdaptiveDetailColumnCount = 1;
        settings.SettingsAdaptivity.AllowOnlyOneAdaptiveDetailExpanded = false;
        settings.SettingsAdaptivity.HideDataCellsAtWindowInnerWidth = 0;

        settings.SettingsPopup.EditForm.SettingsAdaptivity.MaxWidth = 1000;
        settings.SettingsPopup.EditForm.SettingsAdaptivity.MaxHeight = Unit.Percentage(100);
        settings.SettingsPopup.EditForm.SettingsAdaptivity.Mode = PopupControlAdaptivityMode.Always;
        settings.SettingsPopup.EditForm.SettingsAdaptivity.VerticalAlign = PopupAdaptiveVerticalAlign.WindowCenter;
        settings.SettingsPopup.EditForm.SettingsAdaptivity.HorizontalAlign = PopupAdaptiveHorizontalAlign.WindowCenter;
        settings.SettingsPopup.EditForm.Height = 200;

        settings.KeyFieldName = "Id";

        settings.SettingsPager.Visible = true;
        settings.Settings.ShowGroupPanel = true;
        settings.Settings.ShowFilterRow = true;
        settings.SettingsBehavior.AllowSelectByRowClick = true;

        settings.SettingsAdaptivity.AdaptivityMode = GridViewAdaptivityMode.Off;
        settings.SettingsAdaptivity.AdaptiveColumnPosition = GridViewAdaptiveColumnPosition.Right;
        settings.SettingsAdaptivity.AdaptiveDetailColumnCount = 1;
        settings.SettingsAdaptivity.AllowOnlyOneAdaptiveDetailExpanded = false;
        settings.SettingsAdaptivity.HideDataCellsAtWindowInnerWidth = 0;

        //settings.SettingsResizing.ColumnResizeMode = ColumnResizeMode.Control;
        //settings.SettingsResizing.Visualization = ResizingMode.Postponed;
        //settings.SettingsBehavior.AllowEllipsisInText = true;

        settings.Styles.Cell.CssClass = "customBorder";


        settings.Columns.Add(columnSettings =>
        {
            columnSettings.FieldName = "OGT";
            var name = columnSettings.Caption = "Номер раздела";
            columnSettings.Width = Unit.Pixel(135);
        });
        settings.Columns.Add(columnSettings =>
        {
            columnSettings.FieldName = "NaimOgt";
            var name = columnSettings.Caption = "Наименование ОГТ";
            columnSettings.Width = Unit.Pixel(800);
            columnSettings.HeaderStyle.Wrap = DefaultBoolean.True;
            columnSettings.CellStyle.Wrap = DefaultBoolean.True;
            columnSettings.CellStyle.VerticalAlign = VerticalAlign.Top;
        });
        settings.Columns.Add(columnSettings =>
        {
            columnSettings.FieldName = "PrkmId";
            var x = columnSettings.Caption = "Признак КМ";
            columnSettings.CellStyle.HorizontalAlign = HorizontalAlign.Center;
            columnSettings.Visible = true;
            columnSettings.Width = Unit.Pixel(110);
            columnSettings.ColumnType = MVCxGridViewColumnType.ComboBox;
            var comboBoxProperties = columnSettings.PropertiesEdit as ComboBoxProperties;
            comboBoxProperties.ValueField = "Id";
            comboBoxProperties.TextField = "PrKm";
            comboBoxProperties.ValueType = typeof(string);
            comboBoxProperties.DataSource = ViewBag.PrKm;
        });
        settings.Columns.Add(columnSettings =>
        {
            columnSettings.FieldName = "DocumentStatus.Status";
            var x = columnSettings.Caption = "Статус документа";
            columnSettings.CellStyle.HorizontalAlign = HorizontalAlign.Center;
            columnSettings.Visible = true;
            columnSettings.Width = Unit.Pixel(200);
            columnSettings.ReadOnly = true;
        });
        settings.Columns.Add(columnSettings =>
        {
            columnSettings.GroupIndex = 0;
            columnSettings.SortOrder = DevExpress.Data.ColumnSortOrder.Ascending;
            columnSettings.FieldName = "GrMaterId";
            var x = columnSettings.Caption = "Группа материала";
            columnSettings.Visible = true;
            columnSettings.Width = Unit.Pixel(200);
            columnSettings.ColumnType = MVCxGridViewColumnType.ComboBox;
            var comboBoxProperties = columnSettings.PropertiesEdit as ComboBoxProperties;
            comboBoxProperties.ValueField = "Id";
            comboBoxProperties.TextField = "NomerGrMater";
            comboBoxProperties.ValueType = typeof(string);
            comboBoxProperties.DataSource = ViewBag.GrMater;
        });
        settings.Columns.Add(c =>
        {
            c.FieldName = "Operation";
            c.CellStyle.HorizontalAlign = HorizontalAlign.Center;
            c.Caption = "Операция";
            c.Width = Unit.Pixel(150);
            c.Visible = true;
            c.ReadOnly = true;
        });
        settings.Columns.Add(c =>
        {
            c.FieldName = "OperationDate";
            c.ColumnType = MVCxGridViewColumnType.DateEdit;
            var name = c.Caption = "Дата операции";
            c.Width = Unit.Pixel(150);
            c.ReadOnly = true;
        });
        settings.Columns.Add(c =>
        {
            c.FieldName = "PeriodOpenDate";
            c.ColumnType = MVCxGridViewColumnType.DateEdit;
            var name = c.Caption = "Дата открытия периода";
            c.Width = Unit.Pixel(150);
            c.ReadOnly = true;
        });
        settings.Columns.Add(c =>
        {
            c.FieldName = "PeriodCloseDate";
            c.ColumnType = MVCxGridViewColumnType.DateEdit;
            var name = c.Caption = "Дата закрытия периода";
            c.Width = Unit.Pixel(150);
            c.ReadOnly = true;
        });
        //settings.Columns.Add(columnSettings =>
        //{
        //    //columnSettings.SortOrder = DevExpress.Data.ColumnSortOrder.Ascending;
        //    columnSettings.FieldName = "link_sort";
        //    var x = columnSettings.Caption = "Сортировка ОГТ";
        //    columnSettings.Visible = true;
        //    columnSettings.Width = Unit.Pixel(200);
        //    columnSettings.ColumnType = MVCxGridViewColumnType.ComboBox;
        //    var comboBoxProperties = columnSettings.PropertiesEdit as ComboBoxProperties;
        //    comboBoxProperties.ValueField = "Id";
        //    comboBoxProperties.TextField = "usl_ru";
        //    comboBoxProperties.ValueType = typeof(string);
        //    comboBoxProperties.DataSource = Asu.Web.Controllers.DropDownCollectionController.Get_Sort_Ogt();
        //});

        settings.Toolbars.Add(toolbar =>
        {
            toolbar.Enabled = true;
            toolbar.Position = GridToolbarPosition.Top;
            toolbar.ItemAlign = GridToolbarItemAlign.Left;
            toolbar.Items.Add(item =>
            {
                item.Command = GridViewToolbarCommand.ShowCustomizationDialog;
                item.Text = "Панель Группировки";
                item.Image.IconID = IconID.ActionsFilter16x16devav;
            });
        });
        //settings.PreRender = (sender, e) =>
        //{
        //    MVCxGridView gridView = sender as MVCxGridView;
        //    object row = gridView.GetSelectedFieldValues();
        //    gridView.Selection.SelectRowByKey(row);
        //};
    });
    if (ViewData["EditError"] != null)
    {
        grid.SetEditErrorText((string)ViewData["EditError"]);
    }
}
@grid.Bind(Model).GetHtml()