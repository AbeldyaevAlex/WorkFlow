@using System.Web.UI.WebControls
@using DevExpress.Web.Mvc

@{

    var grid = Html.DevExpress().GridView(settings =>
    {
        settings.Name = "gridView";
        settings.KeyFieldName = "Id";
        settings.CallbackRouteValues = new { Controller = "Sostav_Izdelia", Action = "GridViewPartial" };

        settings.SettingsEditing.AddNewRowRouteValues = new { Controller = "Sostav_Izdelia", Action = "GridViewPartialAddNew" };
        settings.SettingsEditing.UpdateRowRouteValues = new { Controller = "Sostav_Izdelia", Action = "GridViewPartialUpdate" };
        settings.SettingsEditing.DeleteRowRouteValues = new { Controller = "Sostav_Izdelia", Action = "GridViewPartialDelete" };
        settings.CustomActionRouteValues = new { Controller = "Sostav_Izdelia", Action = "GridViewCustomActionPartial" };

        settings.SettingsEditing.Mode = GridViewEditingMode.EditFormAndDisplayRow;
        settings.SettingsEditing.Mode = GridViewEditingMode.PopupEditForm;
        settings.SettingsEditing.EditFormColumnCount = 2;

        settings.SettingsBehavior.AutoExpandAllGroups = true;

        settings.SettingsBehavior.ConfirmDelete = true;
        settings.SettingsBehavior.AllowSelectByRowClick = true;
        settings.SettingsBehavior.AllowFocusedRow = true;
        settings.SettingsBehavior.AllowEllipsisInText = true;
        settings.SettingsBehavior.AllowDragDrop = false;
        settings.SettingsBehavior.MergeGroupsMode = GridViewMergeGroupsMode.Disabled;

        settings.CommandColumn.Width = Unit.Pixel(150);
        settings.Width = System.Web.UI.WebControls.Unit.Percentage(100);


        settings.SettingsPager.PageSize = 50;
        settings.SettingsPager.EnableAdaptivity = true;
        settings.SettingsPager.PageSizeItemSettings.Visible = true;
        settings.SettingsPager.Visible = true;

        settings.CommandColumn.Visible = true;
        settings.CommandColumn.Width = Unit.Pixel(100);
        settings.CommandColumn.ShowNewButton = false;
        settings.CommandColumn.ShowDeleteButton = false;
        settings.CommandColumn.ShowEditButton = true;
        settings.CommandColumn.ButtonRenderMode = GridCommandButtonRenderMode.Secondary;

        settings.SettingsCustomizationDialog.Enabled = true;


        settings.Settings.ShowGroupPanel = false;
        settings.Settings.ShowHeaderFilterButton = true;
        settings.Settings.EnableFilterControlPopupMenuScrolling = true;
        settings.Settings.ShowFilterRowMenuLikeItem = true;
        settings.Settings.ShowStatusBar = GridViewStatusBarMode.Auto;
        settings.Settings.ShowFilterRow = true;

        settings.SettingsAdaptivity.AdaptivityMode = GridViewAdaptivityMode.Off;
        settings.SettingsAdaptivity.AdaptiveColumnPosition = GridViewAdaptiveColumnPosition.Right;
        settings.SettingsAdaptivity.AdaptiveDetailColumnCount = 1;
        settings.SettingsAdaptivity.AllowOnlyOneAdaptiveDetailExpanded = false;
        settings.SettingsAdaptivity.HideDataCellsAtWindowInnerWidth = 0;

        settings.SettingsSearchPanel.CustomEditorName = "searchButtonEdit";



        settings.SettingsPopup.EditForm.SettingsAdaptivity.MaxWidth = 1000;
        settings.SettingsPopup.EditForm.SettingsAdaptivity.Mode = PopupControlAdaptivityMode.Always;
        settings.SettingsPopup.EditForm.SettingsAdaptivity.VerticalAlign = PopupAdaptiveVerticalAlign.WindowCenter;
        settings.SettingsPopup.EditForm.SettingsAdaptivity.HorizontalAlign = PopupAdaptiveHorizontalAlign.WindowCenter;
        settings.ControlStyle.CssClass = "GridViewRootClassName";
        //settings.Columns.Add(columnSettings => {
        //    columnSettings.Caption = "////";
        //    columnSettings.SetDataItemTemplateContent(c => {
        //        ViewContext.Writer.Write(string.Format("span class =\"glyphicon glyphicon-plus\" onclick=\"{0}.AddNewRow();\"></span>", settings.Name));
        //    });
        //});
        settings.Columns.Add(columnSettings =>
        {
            columnSettings.FieldName = "ImageFileName";
            columnSettings.Caption = "~";
            columnSettings.Width = Unit.Pixel(32);
            columnSettings.ColumnType = MVCxGridViewColumnType.Image;
            columnSettings.SetDataItemTemplateContent(c =>
            {
                string imageurl = new UrlHelper(HttpContext.Current.Request.RequestContext).Content(
                    String.Format("~/Content/PkpImage/{0}", DataBinder.Eval(c.DataItem, "Spr_PKP.ImageFileName")));
                ViewContext.Writer.Write(String.Format("<img src =\"{0}\" width = '18' height = '18' alt = '7777' /> ", imageurl));

            });
        });
        settings.Columns.Add(c =>
        {
            c.FieldName = "obozn_var";
            var name = c.Caption = "Обозначение";
            c.Width = Unit.Pixel(300);
            c.GroupIndex = 0;
            c.SortOrder = DevExpress.Data.ColumnSortOrder.Ascending;
        });
        settings.Columns.Add(c =>
        {
            c.FieldName = "obozn";
            c.Caption = "Обозначение";
            c.Width = Unit.Pixel(300);
            //c.GroupIndex = 0;
            //c.SortOrder = DevExpress.Data.ColumnSortOrder.Ascending;
        });
        settings.Columns.Add(columnSettings =>
        {
            columnSettings.FieldName = "var";
            var x = columnSettings.Caption = "Вариант";
            columnSettings.Width = Unit.Pixel(100);
            //columnSettings.GroupIndex = 1;
            //columnSettings.SortOrder = DevExpress.Data.ColumnSortOrder.Ascending;
            //columnSettings.SetHeaderCaptionTemplateContent(c =>
            //{
            //    ViewContext.Writer.Write(string.Format("<h3 align = 'center'>{0}</h3>", x));
            //});
        });
        settings.Columns.Add(columnSettings =>
        {
            columnSettings.FieldName = "link_pkp";
            var x = columnSettings.Caption = "ПКП";
            columnSettings.Visible = true;
            columnSettings.Width = Unit.Pixel(200);
            columnSettings.ColumnType = MVCxGridViewColumnType.ComboBox;
            //columnSettings.SetHeaderCaptionTemplateContent(c =>
            //{
            //    ViewContext.Writer.Write(string.Format("<h3 align = 'center' style = 'color: #b3d9ff'>{0}</h3>", x));
            //});
            var comboBoxProperties = columnSettings.PropertiesEdit as ComboBoxProperties;
            comboBoxProperties.DataSource = Asu.Web.Controllers.DropDownCollectionController.GetPkp();
            comboBoxProperties.ValueField = "Id";
            comboBoxProperties.TextField = "nm_pkp";
            comboBoxProperties.ValueType = typeof(string);
        });
        settings.Columns.Add(columnSettings =>
        {
            columnSettings.FieldName = "link_status";
            var x = columnSettings.Caption = "Статус документа";
            columnSettings.Visible = true;
            columnSettings.Width = Unit.Pixel(200);
            columnSettings.ColumnType = MVCxGridViewColumnType.ComboBox;
            //columnSettings.SetHeaderCaptionTemplateContent(c =>
            //{
            //    ViewContext.Writer.Write(string.Format("<h3 align = 'center' style = 'color: #b3d9ff'>{0}</h3>", x));
            //});

            var comboBoxProperties = columnSettings.PropertiesEdit as ComboBoxProperties;
            comboBoxProperties.ValueField = "Id";
            comboBoxProperties.TextField = "status";
            comboBoxProperties.ValueType = typeof(string);
            comboBoxProperties.DataSource = Asu.Web.Controllers.DropDownCollectionController.GetStatus();
        });
        settings.Columns.Add(columnSettings =>
        {
            columnSettings.FieldName = "link_naim";
            var x = columnSettings.Caption = "Наименование";
            columnSettings.Visible = true;
            columnSettings.Width = Unit.Pixel(200);
            columnSettings.ColumnType = MVCxGridViewColumnType.ComboBox;
            //columnSettings.GroupIndex = 1;
            //columnSettings.SortOrder = DevExpress.Data.ColumnSortOrder.Ascending;
            //columnSettings.SetHeaderCaptionTemplateContent(c =>
            //{
            //    ViewContext.Writer.Write(string.Format("<h3 align = 'center' style = 'color: #b3d9ff'>{0}</h3>", x));
            //});

            var comboBoxProperties = columnSettings.PropertiesEdit as ComboBoxProperties;
            comboBoxProperties.ValueField = "Id";
            comboBoxProperties.TextField = "naim_det";
            comboBoxProperties.ValueType = typeof(string);
            comboBoxProperties.DataSource = Asu.Web.Controllers.DropDownCollectionController.GetNaim();
        });
        settings.Columns.Add(columnSettings =>
        {
            columnSettings.FieldName = "link_mater";
            var x = columnSettings.Caption = "Материал";
            columnSettings.Visible = true;
            columnSettings.Width = Unit.Pixel(200);
            columnSettings.ColumnType = MVCxGridViewColumnType.ComboBox;
            //columnSettings.SetHeaderCaptionTemplateContent(c =>
            //{
            //    ViewContext.Writer.Write(string.Format("<h3 align = 'center' style = 'color: #b3d9ff'>{0}</h3>", x));
            //});
            var comboBoxProperties = columnSettings.PropertiesEdit as ComboBoxProperties;
            comboBoxProperties.ValueField = "Id";
            comboBoxProperties.TextField = "nm_mater";
            comboBoxProperties.ValueType = typeof(string);
            comboBoxProperties.DataSource = Asu.Web.Controllers.DropDownCollectionController.GetMater();
        });
        settings.Columns.Add(columnSettings =>
        {
            columnSettings.FieldName = "mas1sh";
            var x = columnSettings.Caption = "Масса на ед.";
            //columnSettings.SetHeaderCaptionTemplateContent(c =>
            //{
            //    ViewContext.Writer.Write(string.Format("<h3 align = 'center' style = 'color: #b3d9ff'>{0}</h3>", x));
            //});
        });
        settings.Columns.Add(columnSettings =>
        {
            var y = columnSettings.FieldName = "operation";
            var x = columnSettings.Caption = "Операция";
            columnSettings.Width = Unit.Pixel(200);
            //columnSettings.SetHeaderCaptionTemplateContent(c =>
            //{
            //    ViewContext.Writer.Write(string.Format("<h3 align = 'center' style = 'color: #b3d9ff'>{0}</h3>", x));
            //});
        });
        settings.Columns.Add(columnSettings =>
        {
            var y = columnSettings.FieldName = "operation_date";
            var x = columnSettings.Caption = "Дата операции";
            columnSettings.ColumnType = MVCxGridViewColumnType.DateEdit;
            columnSettings.Settings.AutoFilterCondition = AutoFilterCondition.Equals;
            columnSettings.Width = Unit.Pixel(200);
            //columnSettings.SetHeaderCaptionTemplateContent(c =>
            //{
            //    ViewContext.Writer.Write(string.Format("<h3 align = 'center' style = 'color: #b3d9ff'>{0}</h3>", x));
            //});
        });

        settings.EditFormLayoutProperties.ColCount = 2;
        settings.EditFormLayoutProperties.Items.Add(col =>
        {
            col.ColumnName = "obozn";
            col.Width = System.Web.UI.WebControls.Unit.Percentage(130);
        });
        settings.EditFormLayoutProperties.Items.Add("link_pkp");
        settings.EditFormLayoutProperties.Items.AddCommandItem(itemSettings =>
        {
            itemSettings.Width = System.Web.UI.WebControls.Unit.Percentage(30);
            itemSettings.HorizontalAlign = FormLayoutHorizontalAlign.Center;
        });


        settings.Toolbars.Add(toolbar =>
        {
            toolbar.Enabled = true;
            toolbar.Position = GridToolbarPosition.Top;
            toolbar.ItemAlign = GridToolbarItemAlign.Left;
            toolbar.Items.Add(item =>
            {
                item.Command = GridViewToolbarCommand.ShowCustomizationDialog;
                item.Text = "Панель Группировки";
                item.Image.IconID = IconID.ActionsFilter16x16devav;
            });
        });
        settings.SettingsDetail.AllowOnlyOneMasterRowExpanded = false;
        settings.SettingsDetail.ShowDetailRow = true;
        settings.SetDetailRowTemplateContent(c =>
        {
            Html.RenderAction("Index", "Prim_dse", new { obozn = DataBinder.Eval(c.DataItem, "Id") });
        });
    });
    if (ViewData["EditError"] != null)
    {
        grid.SetEditErrorText((string)ViewData["EditError"]);
    }
    }
    @grid.Bind(Model).GetHtml()












