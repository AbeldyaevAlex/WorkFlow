        settings.Name = "GridView" + ViewData["specificationKey"];
        settings.CallbackRouteValues = new { Controller = "Sostav_Izdelia", Action = "SpecificationGridView", key = ViewData["specificationKey"] };

        settings.SettingsEditing.AddNewRowRouteValues = new { Controller = "Sostav_Izdelia", Action = "SpecificationGridViewAddNew" };
