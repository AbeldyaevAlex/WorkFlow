            columnSettings.FieldName = "link_user";
            var x = columnSettings.Caption = "Пользователь";
            columnSettings.Visible = true;
            columnSettings.Width = Unit.Pixel(125);
            columnSettings.CellStyle.Wrap = DefaultBoolean.True;
