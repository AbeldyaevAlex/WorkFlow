    <script type="text/javascript">
        $(document).ready(function () {
            $('#Theme').change(function () {
                $.get("/Sostav_Izdelia/GetProducts", { Id: $("#Theme").val() }, function (data) {
                    $('#Id').empty();
                    $.each(data, function (index, row) {
                        $('#Id').append("<option value = '" + row.Id + "'>" + row.NmIzd + "</option>")
                    });
                });
            })
        })
    </script>


</head>
<body>
    <div style="margin:90px; padding: 10px 10px 10px 10px; border: 2px solid black ">
        @using (Html.BeginForm("GetThemesAndProduct", "Sostav_Izdelia", FormMethod.Post))
        {
            <div style="width: 100%; padding: 0 0 10px 0; ">
                @(Html.Kendo().DropDownList().Name("Theme").DataTextField("Nm_tem_k").DataValueField("Id").Filter(FilterType.Contains)
                        .HtmlAttributes(new { style = "width:600px; ", placeholder = "Введите тему", required = "required", validationmessage = "Обязателен", @id = "Theme", @name = "Theme" })
                        .DataSource(source =>
                        {
                            source.Read(read =>
                            {
                                read.Action("DropDownListGetThemesAndProduct", "Sostav_Izdelia", "msi");
                            });
                        })
                        )
            </div>
            <div style="width: 600px; padding:0 0 10px 0;">
                @Html.DropDownListFor(model => model.Id, new SelectList(" "), "- Выбрать изделие -", new { @class = "form-control", @name = "Product", style = "max-width: 600px" })
            </div>
            <input class="btn btn-primary" id="btnSubmit" type="submit" value="Применить" />
        }
    </div>
</body>
