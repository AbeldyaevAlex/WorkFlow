                Html.DevExpress().CheckBoxList(chSettings =>
                {
                    chSettings.Name = "per_izd";
                    chSettings.Properties.TextField = "nm_izd";
                    chSettings.Properties.ValueField = "Id";
                    chSettings.Properties.ValueType = typeof(int);

                    Spr_Perizd editItem = new Spr_Perizd();

                    if (c.Grid.IsEditing)
                    {
                        editItem = c.Grid.IsNewRowEditing ? new Spr_Perizd() : new Spr_Perizd();
                    }
                    else
                    {
                        editItem = c.Grid.IsNewRowEditing ? new Spr_Perizd() : (Spr_Perizd)c.Grid.GetRow(c.VisibleIndex);
                    }


                    chSettings.PreRender = (sender, e) =>
                    {
                        if (!string.IsNullOrEmpty(editItem.nm_izd))
                        {
                            var cb = (MVCxCheckBoxList)sender;
                            foreach (ListEditItem listItem in cb.Items)
                            {
                                if (editItem.nm_izd.Contains(listItem.Text))
                                    listItem.Selected = true;
                            }
                        }
                    };

