@model Asu.Web.Models.SubjectAndProductsViewModel
@{
    ViewBag.Title = "Параметры для получения номенклатуры";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@using (Html.BeginForm("GetNomenclature", "Nomenclature", "msi", FormMethod.Post))
{
    <div style="margin-top: 100px; margin-bottom: 200px; padding: 0 0 100px 0;">
        <h1 align="center">Введите параметры для получения номенклатуры</h1>
        <div class="container">
            <div class="form-group">
                @if (ViewBag.ListTem != null)
                {
                    @Html.DropDownListFor(model => model.SubjecId, ViewBag.ListTem as SelectList, "- Выбрать тема -", new { @class = "form-control" })
                }
            </div>
        </div>
        <div class="container">
            <div class="form-group">
                @Html.DropDownListFor(model => model.ProductId, new SelectList(" "), "- Выбрать изделие -", new { @class = "form-control" })
            </div>
        </div>
        <div class="container">
            <div class="form-group">
                @Html.DropDownListFor(model => model.Series, new SelectList(" "), "- Выбрать серию -", new { @class = "form-control" })
            </div>
        </div>
        <div class="container">
            <div class="form-group">
                @Html.DropDownListFor(model => model.srez_sostoyanieId, Model.AvaliableConditions, new { @class = "form-control" })
                @Html.ValidationMessageFor(model => model.srez_sostoyanieId, "", new { @class = "text-danger" })
            </div>
        </div>
        <div align="center">
            <input type="submit" value="Ok" />
        </div>
    </div>
}

<link href="~/Content/bootstrap/bootstrap.min.css" rel="stylesheet" />
<script src="~/Scripts/bootstrap.min.js"></script>
<script src="~/Scripts/jquery-3.7.1.js"></script>
<script src="~/Scripts/jquery-3.7.1.min.js"></script>

<script type="text/javascript">
    $(document).ready(function () {
        $('#SubjecId').change(function () {
            $.get("/GetNodalizedArray/GetProductList", { SubjecId: $("#SubjecId").val() }, function (data) {
                $('#ProductId').empty();
                $.each(data, function (index, row) {
                    $('#ProductId').append("<option value = '" + row.Id + "'>" + row.NmIzd + "</option>")
                });
            });
        })
    })
</script>
<script type="text/javascript">
    $(document).ready(function () {
        $('#ProductId').change(function () {
            $.get("/GetNodalizedArray/GetSeriaList", { ProductId: $("#ProductId").val() }, function (data) {
                $('#Series').empty();
                $.each(data, function (index, row) {
                    $('#Series').append("<option value = '" + row.NomMash + "'>" + row.NomMash + "</option>")
                });
            });
        })
    })
</script>


