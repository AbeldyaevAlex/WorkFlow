            comitem.VerticalAlign = FormLayoutVerticalAlign.Bottom;
        });
        settings.EditFormLayoutProperties.Items.Add(Group =>
        {
            Group.Caption = "Сформировать";
            Group.SetTemplateContent(template => ViewContext.Writer.Write("<button class='uu''>Сформировать</button>"));
        });
        settings.CellEditorInitialize = (s, e) =>
        {
            ((ASPxEdit)e.Editor).ValidationSettings.Display = Display.Dynamic;
        };
        //settings.ClientSideEvents.Init = "OnEndCallBack";


    });


    if (ViewData["EditError"] != null)
    {
        grid.SetEditErrorText((string)ViewData["EditError"]);
    }
}
