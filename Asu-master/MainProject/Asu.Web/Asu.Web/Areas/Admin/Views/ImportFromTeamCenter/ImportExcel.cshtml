                    type: 'POST',
                    url: '@Url.Action("SaveRegistration", "ImportFromTeamCenter", "admin_default")',
                    contentType: false,
                    processData: false,
                    success: function (data) {
                        alert(data.message);
                    }
                })
            })
        })
