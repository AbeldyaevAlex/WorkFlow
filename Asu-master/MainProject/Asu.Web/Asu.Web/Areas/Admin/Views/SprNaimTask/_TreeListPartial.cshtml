@using System.Web.UI.WebControls
@using DevExpress.Web.Mvc
@{
    var treeList = Html.DevExpress().TreeList(settings =>
    {
        settings.Name = "TreeList";
        settings.CallbackRouteValues = new { Controller = "SprNaimTask", Action = "TreeListPartial" };

        settings.SettingsEditing.AddNewNodeRouteValues = new { Controller = "SprNaimTask", Action = "TreeListPartialAddNew" };
        settings.SettingsEditing.UpdateNodeRouteValues = new { Controller = "SprNaimTask", Action = "TreeListPartialUpdate" };
        settings.SettingsEditing.DeleteNodeRouteValues = new { Controller = "SprNaimTask", Action = "TreeListPartialDelete" };
        settings.SettingsEditing.NodeDragDropRouteValues = new { Controller = "SprNaimTask", Action = "TreeListPartialMove" };

        settings.CommandColumn.Visible = true;
        settings.CommandColumn.NewButton.Visible = true;
        settings.CommandColumn.DeleteButton.Visible = true;
        settings.CommandColumn.EditButton.Visible = true;

        settings.KeyFieldName = "Id";
        settings.ParentFieldName = "Id_Roditel";
        settings.Columns.Add(
    column =>
    {
        column.FieldName = "Task";
    }
);
        settings.Columns.Add(
    column =>
    {
        column.FieldName = "Naim_task";
    }
);
        settings.Columns.Add(
    column =>
    {
        column.FieldName = "link_status";
    }
);
        settings.Columns.Add(
    column =>
    {
        column.FieldName = "link_user";
    }
);
        settings.Columns.Add(
    column =>
    {
        column.FieldName = "operation";
    }
);
        settings.Columns.Add(
    column =>
    {
        column.FieldName = "operation_date";
    }
);
        settings.Columns.Add(
    column =>
    {
        column.FieldName = "period_open_date";
    }
);
        settings.Columns.Add(
    column =>
    {
        column.FieldName = "period_close_date";
    }
);
        settings.Columns.Add(
    column =>
    {
        column.FieldName = "Id_Roditel";
    }
);
        settings.Columns.Add(
    column =>
    {
        column.FieldName = "screen";
        column.ColumnType = MVCxTreeListColumnType.Image;
    }
);
        settings.Columns.Add(
    column =>
    {
        column.SetEditCellTemplateContent(container =>
        {
            using (Html.BeginForm("TreeListPartialAddNew", "SprNaimTask", FormMethod.Post))
            {
                Html.DevExpress().UploadControl(upload =>
                {
                    upload.Name = "Images_Path";
                    upload.ShowUploadButton = true;
                }).Render();
            }
        });
    }
);

        settings.Columns.Add(
    column =>
    {
        column.FieldName = "naim_screen";
    }
);
        settings.Columns.Add(
    column =>
    {
        column.FieldName = "AlternativeText";
    }
);
        settings.Columns.Add(
    column =>
    {
        column.FieldName = "Controller_Name";
    }
);
        settings.Columns.Add(
    column =>
    {
        column.FieldName = "Action_Name";
    }
);
        settings.Columns.Add(
    column =>
    {
        column.FieldName = "IsGroup";
    }
);
        settings.Columns.Add(
    column =>
    {
        column.FieldName = "RouteUrl";
    }
);
        settings.Columns.Add(
    column =>
    {
        column.FieldName = "Title";
    }
);

        settings.SettingsPager.Visible = true;
        settings.SettingsSelection.Enabled = true;
    });
    if (ViewData["EditError"] != null)
    {
        treeList.SetEditErrorText((string)ViewData["EditError"]);
    }
}
@treeList.Bind(Model).GetHtml()